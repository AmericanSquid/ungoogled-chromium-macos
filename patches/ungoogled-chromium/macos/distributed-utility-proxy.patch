+
+constexpr char kDataDecoderServiceName[] =
+    "data_decoder.mojom.DataDecoderService";
+constexpr char kEnableDistributedDataDecoder[] =
+    "distributed-data-decoder";
+constexpr char kDistributedWorker[] = "distributed-worker";
+
