+mojo_base::BigBuffer ToBigBuffer(const std::string& input) {
+  mojo_base::BigBuffer buffer(input.size());
+  if (!input.empty()) {
+    std::memcpy(buffer.data(), input.data(), input.size());
+  }
+  return buffer;
+}
+
+std::string ToString(const mojo_base::BigBuffer& input) {
+  if (input.size() == 0) {
+    return std::string();
+  }
+  return std::string(static_cast<const char*>(input.data()), input.size());
+}
+
+void SetUint32(uint32_t value, size_t offset, std::string* output) {
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    (*output)[offset++] = static_cast<char>((value >> shift) & 0xff);
+  }
+}
+
+void SetUint64(uint64_t value, size_t offset, std::string* output) {
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    (*output)[offset++] = static_cast<char>((value >> shift) & 0xff);
+  }
+}
+
+RemoteGzipperRequest MakeRequest(uint64_t request_id = 77) {
+  return RemoteGzipperRequest{
+      request_id, static_cast<uint8_t>(RemoteGzipperOperation::kDeflate),
+      "worker-token", std::string("binary\0input", 12)};
+}
+
+class RemoteGzipperWorkerTest : public testing::Test {
+ protected:
+  RemoteGzipperWorkerTest() : worker_("worker-token") {}
+
+  void SetUp() override {
+    ASSERT_TRUE(worker_.Start(
+        net::IPEndPoint(net::IPAddress::IPv4Localhost(), /*port=*/0)));
+    ASSERT_TRUE(worker_.GetLocalAddressForTesting(&endpoint_));
+  }
+
+  RemoteGzipperResponse Exchange(const std::string& request) {
+    net::TCPClientSocket socket(net::AddressList(endpoint_), nullptr, nullptr,
+                                nullptr, net::NetLogSource(),
+                                net::handles::kInvalidNetworkHandle);
+
+    net::TestCompletionCallback connect_callback;
+    int result = socket.Connect(connect_callback.callback());
+    CHECK_EQ(net::OK, connect_callback.GetResult(result));
+
+    auto source = base::MakeRefCounted<net::StringIOBuffer>(request);
+    auto write_buffer = base::MakeRefCounted<net::DrainableIOBuffer>(
+        source, static_cast<int>(request.size()));
+    while (write_buffer->BytesRemaining() > 0) {
+      net::TestCompletionCallback write_callback;
+      result =
+          socket.Write(write_buffer.get(), write_buffer->BytesRemaining(),
+                       write_callback.callback(), TRAFFIC_ANNOTATION_FOR_TESTS);
+      result = write_callback.GetResult(result);
+      CHECK_GT(result, 0);
+      write_buffer->DidConsume(result);
+    }
+
+    std::string response_bytes;
+    while (true) {
+      auto read_buffer = base::MakeRefCounted<net::IOBufferWithSize>(4096);
+      net::TestCompletionCallback read_callback;
+      result = socket.Read(read_buffer.get(), read_buffer->size(),
+                           read_callback.callback());
+      result = read_callback.GetResult(result);
+      CHECK_GT(result, 0);
+      response_bytes.append(read_buffer->data(), static_cast<size_t>(result));
+      auto response = ParseRemoteGzipperResponse(response_bytes);
+      if (response) {
+        return std::move(*response);
+      }
+    }
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::IO};
+  RemoteGzipperWorker worker_;
+  net::IPEndPoint endpoint_;
+};
+
+TEST_F(RemoteGzipperWorkerTest, DeflatesWithChromiumGzipperAndPreservesId) {
+  const auto request = MakeRequest(981);
+  const auto serialized = SerializeRemoteGzipperRequest(request);
+  ASSERT_TRUE(serialized);
+
+  const RemoteGzipperResponse response = Exchange(*serialized);
+  EXPECT_EQ(981u, response.request_id);
+  EXPECT_EQ(RemoteGzipperStatus::kSuccess, response.status);
+  EXPECT_EQ(RemoteGzipperError::kNone, response.error);
+
+  data_decoder::Gzipper gzipper;
+  base::test::TestFuture<std::optional<mojo_base::BigBuffer>> expected;
+  gzipper.Deflate(ToBigBuffer(request.payload), expected.GetCallback());
+  ASSERT_TRUE(expected.Get());
+  EXPECT_EQ(ToString(*expected.Get()), response.payload);
+}
+
+TEST_F(RemoteGzipperWorkerTest, RejectsMissingToken) {
+  const auto request = MakeRequest(82);
+  auto serialized = SerializeRemoteGzipperRequest(request);
+  ASSERT_TRUE(serialized);
+  serialized->erase(kRemoteGzipperRequestHeaderSize,
+                    request.authentication_data.size());
+  SetUint32(0, 16, &*serialized);
+
+  const RemoteGzipperResponse response = Exchange(*serialized);
+  EXPECT_EQ(82u, response.request_id);
+  EXPECT_EQ(RemoteGzipperStatus::kFailure, response.status);
+  EXPECT_EQ(RemoteGzipperError::kMissingAuthentication, response.error);
+  EXPECT_TRUE(response.payload.empty());
+}
+
+TEST_F(RemoteGzipperWorkerTest, RejectsBadToken) {
+  auto request = MakeRequest(83);
+  request.authentication_data = "incorrect-token";
+  const auto serialized = SerializeRemoteGzipperRequest(request);
+  ASSERT_TRUE(serialized);
+
+  const RemoteGzipperResponse response = Exchange(*serialized);
+  EXPECT_EQ(83u, response.request_id);
+  EXPECT_EQ(RemoteGzipperError::kAuthenticationFailed, response.error);
+}
+
+TEST_F(RemoteGzipperWorkerTest, RejectsUnsupportedOperation) {
+  auto request = MakeRequest(84);
+  request.operation_id = 99;
+  const auto serialized = SerializeRemoteGzipperRequest(request);
+  ASSERT_TRUE(serialized);
+
+  const RemoteGzipperResponse response = Exchange(*serialized);
+  EXPECT_EQ(84u, response.request_id);
+  EXPECT_EQ(RemoteGzipperError::kUnsupportedOperation, response.error);
+}
+
+TEST_F(RemoteGzipperWorkerTest, RejectsMalformedFrameWithRequestId) {
+  auto serialized = SerializeRemoteGzipperRequest(MakeRequest(85));
+  ASSERT_TRUE(serialized);
+  (*serialized)[0] = 'X';
+
+  const RemoteGzipperResponse response = Exchange(*serialized);
+  EXPECT_EQ(85u, response.request_id);
+  EXPECT_EQ(RemoteGzipperError::kMalformedFrame, response.error);
+}
+
+TEST_F(RemoteGzipperWorkerTest, RejectsOversizedPayloadBeforeReadingIt) {
+  auto serialized = SerializeRemoteGzipperRequest(MakeRequest(86));
+  ASSERT_TRUE(serialized);
+  serialized->resize(kRemoteGzipperRequestHeaderSize);
+  SetUint64(kRemoteGzipperMaxPayloadSize + 1, 20, &*serialized);
+
+  const RemoteGzipperResponse response = Exchange(*serialized);
+  EXPECT_EQ(86u, response.request_id);
+  EXPECT_EQ(RemoteGzipperError::kOversizedPayload, response.error);
+}
+
+TEST_F(RemoteGzipperWorkerTest, ShutdownIsIdempotent) {
+  worker_.Shutdown();
+  worker_.Shutdown();
+  EXPECT_FALSE(worker_.GetLocalAddressForTesting(&endpoint_));
