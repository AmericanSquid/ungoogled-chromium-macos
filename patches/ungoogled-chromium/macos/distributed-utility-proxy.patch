+namespace {
+
+using Buffer = mojo_base::BigBuffer;
+using Result = std::optional<Buffer>;
+
+Buffer ToBuffer(const std::string& data) {
+  Buffer result(data.size());
+  if (!data.empty()) {
+    std::memcpy(result.data(), data.data(), data.size());
+  }
+  return result;
+}
+
+std::string ToString(const Buffer& data) {
+  if (data.size() == 0) {
+    return std::string();
+  }
+  return std::string(static_cast<const char*>(data.data()), data.size());
+}
+
+struct FallbackState {
+  int calls = 0;
+  std::string input;
+};
+
+class RemoteDeflateFallbackTest : public testing::Test {
+ protected:
+  void ExpectLocalFallback(RemoteGzipperOutcome outcome) {
+    auto fallback_state =
+        base::MakeRefCounted<base::RefCountedData<FallbackState>>();
+    base::test::TestFuture<Result> result;
+    CompleteRemoteDeflateOrFallback(
+        RemoteGzipperResult{outcome, "remote-result"}, ToBuffer("original"),
+        result.GetCallback(),
+        base::BindRepeating(
+            [](scoped_refptr<base::RefCountedData<FallbackState>> state,
+               Buffer input,
+               data_decoder::mojom::Gzipper::DeflateCallback callback) {
+              ++state->data.calls;
+              state->data.input = ToString(input);
+              std::move(callback).Run(ToBuffer("local-result"));
+            },
+            fallback_state));
+
+    ASSERT_TRUE(result.Get());
+    EXPECT_EQ("local-result", ToString(*result.Get()));
+    EXPECT_EQ(1, fallback_state->data.calls);
+    EXPECT_EQ("original", fallback_state->data.input);
+  }
+};
+
+TEST_F(RemoteDeflateFallbackTest, ReturnsRemoteDeflateSuccess) {
+  auto fallback_state =
+      base::MakeRefCounted<base::RefCountedData<FallbackState>>();
+  base::test::TestFuture<Result> result;
+  CompleteRemoteDeflateOrFallback(
+      RemoteGzipperResult{RemoteGzipperOutcome::kSuccess, "remote-result"},
+      ToBuffer("original"), result.GetCallback(),
+      base::BindRepeating(
+          [](scoped_refptr<base::RefCountedData<FallbackState>> state, Buffer,
+             data_decoder::mojom::Gzipper::DeflateCallback callback) {
+            ++state->data.calls;
+            std::move(callback).Run(ToBuffer("local-result"));
+          },
+          fallback_state));
+
+  ASSERT_TRUE(result.Get());
+  EXPECT_EQ("remote-result", ToString(*result.Get()));
+  EXPECT_EQ(0, fallback_state->data.calls);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackWhenWorkerIsUnavailable) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kUnavailable);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackWhenWorkerReportsFailure) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kWorkerFailure);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackAfterAuthenticationFailure) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kAuthenticationFailure);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackAfterTimeout) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kTimeout);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackAfterDisconnect) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kDisconnect);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackAfterMalformedResponse) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kMalformedResponse);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackAfterUnsupportedOperation) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kUnsupportedOperation);
+}
+
+TEST_F(RemoteDeflateFallbackTest, FallsBackWhenAnotherRequestIsOutstanding) {
+  ExpectLocalFallback(RemoteGzipperOutcome::kBusy);
+}
