+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_DISTRIBUTED_DISTRIBUTED_UTILITY_PROXY_H_
+#define CONTENT_DISTRIBUTED_DISTRIBUTED_UTILITY_PROXY_H_
+
+#include <optional>
+#include <string>
+
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "services/data_decoder/public/mojom/data_decoder_service.mojom.h"
+
+namespace content::distributed {
+
+bool IsRemoteEligibleUtilityService(const std::string& service_name);
+
+// Returns true only when the distributed utility proxy was explicitly enabled.
+bool IsDistributedUtilityProxyEnabled();
+
+// Returns the configured worker endpoint, for example "100.64.0.2:8765".
+// An empty result means no worker endpoint was configured.
+std::string GetDistributedUtilityWorkerEndpoint();
+
+// Returns the configured token-file path, or an empty string if it is absent.
+std::string GetDistributedUtilityTokenFile();
+
+// Reads and trims the required authentication token. It never logs the token.
+std::optional<std::string> GetDistributedUtilityToken();
+
+// Returns true only when remote routing has its required configuration.
+bool ShouldRouteDataDecoderRemotely();
+
+// Records that the configured remote route has fallen back to the local
+// service after a transport or worker failure.
+void LogRemoteDataDecoderFallback(const std::string& worker_endpoint);
+
+void BindRemoteDataDecoderService(
+    mojo::PendingReceiver<data_decoder::mojom::DataDecoderService> receiver,
+    std::string worker_endpoint,
+    std::string authentication_data,
+    mojo::PendingRemote<data_decoder::mojom::DataDecoderService>
+        local_service);
+
+void LogRemoteEligibleUtilityService(const std::string& service_name);
+
+}  // namespace content::distributed
+
+#endif  // CONTENT_DISTRIBUTED_DISTRIBUTED_UTILITY_PROXY_H_
diff --git a/content/distributed/remote_data_decoder_service.cc b/content/distributed/remote_data_decoder_service.cc
new file mode 100644
index 00000000..aa0897a5
--- /dev/null
+++ b/content/distributed/remote_data_decoder_service.cc
@@ -0,0 +1,220 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/remote_data_decoder_service.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+
+namespace content::distributed {
+namespace {
+
+using DataDecoder = data_decoder::mojom::DataDecoderService;
+using Gzipper = data_decoder::mojom::Gzipper;
+using Buffer = mojo_base::BigBuffer;
+
+std::atomic<uint64_t> next_id{1};
+
+Buffer ToBuffer(const std::string& data) {
+  Buffer result(data.size());
+  if (!data.empty()) {
+    std::memcpy(result.data(), data.data(), data.size());
+  }
+  return result;
+}
+
+std::string ToString(const Buffer& data) {
+  if (data.size() == 0) {
+    return std::string();
+  }
+  return std::string(reinterpret_cast<const char*>(data.data()), data.size());
+}
+
+class RemoteGzipper final : public Gzipper {
+ public:
+  RemoteGzipper(std::string endpoint,
+                std::string authentication_data,
+                mojo::PendingRemote<Gzipper> local_gzipper)
+      : client_(std::move(endpoint), std::move(authentication_data)) {
+    local_gzipper_.Bind(std::move(local_gzipper));
+  }
+
+  RemoteGzipper(const RemoteGzipper&) = delete;
+  RemoteGzipper& operator=(const RemoteGzipper&) = delete;
+  ~RemoteGzipper() override = default;
+
+  // Only Deflate may leave the browser process. The remaining Gzipper methods
+  // are always forwarded to the local Data Decoder service.
+  void Deflate(Buffer data, DeflateCallback callback) override {
+    const std::string original_data = ToString(data);
+    RemoteGzipperRequest request{
+        next_id.fetch_add(1),
+        static_cast<uint8_t>(RemoteGzipperOperation::kDeflate), std::string(),
+        original_data};
+    client_.Send(std::move(request),
+                 base::BindOnce(&RemoteGzipper::OnRemoteDeflateComplete,
+                                weak_factory_.GetWeakPtr(),
+                                ToBuffer(original_data), std::move(callback)));
+  }
+
+  void Inflate(Buffer data, uint64_t limit, InflateCallback callback) override {
+    local_gzipper_->Inflate(std::move(data), limit, std::move(callback));
+  }
+
+  void Compress(Buffer data, CompressCallback callback) override {
+    local_gzipper_->Compress(std::move(data), std::move(callback));
+  }
+
+  void Uncompress(Buffer data, UncompressCallback callback) override {
+    local_gzipper_->Uncompress(std::move(data), std::move(callback));
+  }
+
+ private:
+  void OnRemoteDeflateComplete(Buffer original_data,
+                               DeflateCallback callback,
+                               RemoteGzipperResult remote_result) {
+    CompleteRemoteDeflateOrFallback(
+        std::move(remote_result), std::move(original_data), std::move(callback),
+        base::BindRepeating(&RemoteGzipper::DeflateLocally,
+                            weak_factory_.GetWeakPtr()));
+  }
+
+  void DeflateLocally(Buffer data, DeflateCallback callback) {
+    local_gzipper_->Deflate(std::move(data), std::move(callback));
+  }
+
+  mojo::Remote<Gzipper> local_gzipper_;
+  RemoteGzipperClient client_;
+  base::WeakPtrFactory<RemoteGzipper> weak_factory_{this};
+};
+
+class RemoteDataDecoder final : public DataDecoder {
+ public:
+  RemoteDataDecoder(std::string endpoint,
+                    std::string authentication_data,
+                    mojo::PendingRemote<DataDecoder> local_service)
+      : endpoint_(std::move(endpoint)),
+        authentication_data_(std::move(authentication_data)) {
+    CHECK(local_service.is_valid());
+    local_service_.Bind(std::move(local_service));
+  }
+
+  RemoteDataDecoder(const RemoteDataDecoder&) = delete;
+  RemoteDataDecoder& operator=(const RemoteDataDecoder&) = delete;
+  ~RemoteDataDecoder() override = default;
+
+  // Every DataDecoder interface except Gzipper::Deflate remains local.
+  void BindImageDecoder(mojo::PendingReceiver<data_decoder::mojom::ImageDecoder>
+                            receiver) override {
+    local_service_->BindImageDecoder(std::move(receiver));
+  }
+
+  void BindXmlParser(
+      mojo::PendingReceiver<data_decoder::mojom::XmlParser> receiver) override {
+    local_service_->BindXmlParser(std::move(receiver));
+  }
+
+  void BindWebBundleParserFactory(
+      mojo::PendingReceiver<web_package::mojom::WebBundleParserFactory>
+          receiver) override {
+    local_service_->BindWebBundleParserFactory(std::move(receiver));
+  }
+
+  void BindGzipper(mojo::PendingReceiver<Gzipper> receiver) override {
+    mojo::PendingRemote<Gzipper> local_gzipper;
+    local_service_->BindGzipper(local_gzipper.InitWithNewPipeAndPassReceiver());
+    mojo::MakeSelfOwnedReceiver(
+        std::make_unique<RemoteGzipper>(endpoint_, authentication_data_,
+                                        std::move(local_gzipper)),
+        std::move(receiver));
+  }
+
+  void BindStructuredHeadersParser(
+      mojo::PendingReceiver<data_decoder::mojom::StructuredHeadersParser>
+          receiver) override {
+    local_service_->BindStructuredHeadersParser(std::move(receiver));
+  }
+
+  void BindCborParser(mojo::PendingReceiver<data_decoder::mojom::CborParser>
+                          receiver) override {
+    local_service_->BindCborParser(std::move(receiver));
+  }
+
+  void BindPixCodeValidator(
+      mojo::PendingReceiver<payments::facilitated::mojom::PixCodeValidator>
+          receiver) override {
+    local_service_->BindPixCodeValidator(std::move(receiver));
+  }
+
+ private:
+  mojo::Remote<DataDecoder> local_service_;
+  const std::string endpoint_;
+  const std::string authentication_data_;
+};
+
+}  // namespace
+
+void CompleteRemoteDeflateOrFallback(
+    RemoteGzipperResult remote_result,
+    mojo_base::BigBuffer original_data,
+    data_decoder::mojom::Gzipper::DeflateCallback callback,
+    LocalGzipperDeflateCallback local_deflate) {
+  if (remote_result.outcome == RemoteGzipperOutcome::kSuccess) {
+    std::move(callback).Run(ToBuffer(remote_result.payload));
+    return;
+  }
+  local_deflate.Run(std::move(original_data), std::move(callback));
+}
+
+namespace {
+
+void BindRemoteDataDecoderServiceImpl(
+    mojo::PendingReceiver<data_decoder::mojom::DataDecoderService> receiver,
+    std::string worker_endpoint,
+    std::string authentication_data,
+    mojo::PendingRemote<data_decoder::mojom::DataDecoderService>
+        local_service) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<RemoteDataDecoder>(std::move(worker_endpoint),
+                                          std::move(authentication_data),
+                                          std::move(local_service)),
+      std::move(receiver));
+}
+
+}  // namespace
+
+void BindRemoteDataDecoderService(
+    mojo::PendingReceiver<data_decoder::mojom::DataDecoderService> receiver,
+    std::string worker_endpoint,
+    std::string authentication_data,
+    mojo::PendingRemote<data_decoder::mojom::DataDecoderService>
+        local_service) {
+  BindRemoteDataDecoderServiceImpl(std::move(receiver),
+                                   std::move(worker_endpoint),
+                                   std::move(authentication_data),
+                                   std::move(local_service));
+}
+
+void BindRemoteDataDecoderServiceForTesting(
+    mojo::PendingReceiver<data_decoder::mojom::DataDecoderService> receiver,
+    std::string worker_endpoint,
+    std::string authentication_data,
+    mojo::PendingRemote<data_decoder::mojom::DataDecoderService>
+        local_service) {
+  BindRemoteDataDecoderServiceImpl(
+      std::move(receiver), std::move(worker_endpoint),
+      std::move(authentication_data), std::move(local_service));
+}
+
+}  // namespace content::distributed
