+// Executes one Remote Gzipper protocol exchange on a ThreadPool worker.
+// Network, protocol, and worker failures are returned as nullopt. A failure
+// frame sent by the worker is returned to the caller for local fallback.
+class RemoteGzipperClient {
+ public:
+  using ResponseCallback =
+      base::OnceCallback<void(std::optional<RemoteGzipperFrame>)>;
+
+  explicit RemoteGzipperClient(std::string worker_endpoint);
+  RemoteGzipperClient(const RemoteGzipperClient&) = delete;
+  RemoteGzipperClient& operator=(const RemoteGzipperClient&) = delete;
+  ~RemoteGzipperClient();
+
+  void Send(RemoteGzipperFrame request, ResponseCallback callback);
+
+ private:
+  const std::string worker_endpoint_;
+};
+
+}  // namespace content::distributed
