+enum class WorkerBehavior {
+  kSuccess,
+  kAuthenticationFailure,
+  kHang,
+  kMalformedResponse,
+};
+
+// A deliberately small loopback server. It exercises the production wire
+// protocol without relying on a utility process, Tailscale, or real data.
+class LoopbackWorker {
+ public:
+  explicit LoopbackWorker(WorkerBehavior behavior)
+      : behavior_(behavior), server_(nullptr, net::NetLogSource()) {
+    CHECK_EQ(net::OK,
+             server_.Listen(net::IPEndPoint(net::IPAddress::IPv4Localhost(), 0),
+                            1, std::nullopt));
+    CHECK_EQ(net::OK, server_.GetLocalAddress(&endpoint_));
+    StartAccept();
+  }
+
+  LoopbackWorker(const LoopbackWorker&) = delete;
+  LoopbackWorker& operator=(const LoopbackWorker&) = delete;
+  ~LoopbackWorker() = default;
+
+  std::string endpoint() const { return endpoint_.ToString(); }
+  size_t request_count() const { return requests_.size(); }
+  const RemoteGzipperRequest& request(size_t index) const {
+    return requests_.at(index);
+  }
+
+  void WaitForRequests(size_t count) {
+    if (request_count() >= count) {
+      return;
+    }
+    base::RunLoop run_loop;
+    waiting_for_request_count_ = count;
+    request_received_ = run_loop.QuitClosure();
+    run_loop.Run();
+  }
+
+ private:
+  void StartAccept() {
+    socket_.reset();
+    request_bytes_.clear();
+    const int result = server_.Accept(
+        &socket_,
+        base::BindOnce(&LoopbackWorker::OnAccept, weak_factory_.GetWeakPtr()));
+    CHECK_EQ(net::ERR_IO_PENDING, result);
+  }
+
+  void OnAccept(int result) {
+    if (result == net::OK) {
+      ReadRequest();
+    }
+  }
+
+  void ReadRequest() {
+    read_buffer_ = base::MakeRefCounted<net::IOBufferWithSize>(4096);
+    const int result = socket_->Read(
+        read_buffer_.get(), read_buffer_->size(),
+        base::BindOnce(&LoopbackWorker::OnRead, weak_factory_.GetWeakPtr()));
+    if (result != net::ERR_IO_PENDING) {
+      OnRead(result);
+    }
+  }
+
+  void OnRead(int result) {
+    if (result <= 0) {
+      return;
+    }
+    request_bytes_.append(read_buffer_->data(), static_cast<size_t>(result));
+    read_buffer_.reset();
+    std::optional<RemoteGzipperRequest> parsed =
+        ParseRemoteGzipperRequest(request_bytes_);
+    if (!parsed) {
+      ReadRequest();
+      return;
+    }
+    requests_.push_back(std::move(*parsed));
+    if (request_received_ && request_count() >= waiting_for_request_count_) {
+      std::move(request_received_).Run();
+    }
+    if (behavior_ == WorkerBehavior::kHang) {
+      return;
+    }
+    if (behavior_ == WorkerBehavior::kMalformedResponse) {
+      WriteResponse("malformed-loopback-response");
+      return;
+    }
+    if (behavior_ == WorkerBehavior::kAuthenticationFailure) {
+      const auto response = MakeRemoteGzipperFailureResponse(
+          requests_.back().request_id,
+          RemoteGzipperError::kAuthenticationFailed);
+      const auto serialized = SerializeRemoteGzipperResponse(response);
+      CHECK(serialized);
+      WriteResponse(*serialized);
+      return;
+    }
+    gzipper_.Deflate(
+        ToBuffer(requests_.back().payload),
+        base::BindOnce(&LoopbackWorker::OnDeflated, weak_factory_.GetWeakPtr(),
+                       requests_.back().request_id));
+  }
+
+  void OnDeflated(uint64_t request_id, std::optional<Buffer> output) {
+    CHECK(output);
+    const RemoteGzipperResponse response{
+        request_id, RemoteGzipperStatus::kSuccess, RemoteGzipperError::kNone,
+        ToString(*output)};
+    const auto serialized = SerializeRemoteGzipperResponse(response);
+    CHECK(serialized);
+    WriteResponse(*serialized);
+  }
+
+  void WriteResponse(std::string response) {
+    auto source =
+        base::MakeRefCounted<net::StringIOBuffer>(std::move(response));
+    write_buffer_ =
+        base::MakeRefCounted<net::DrainableIOBuffer>(source, source->size());
+    WriteMore();
+  }
+
+  void WriteMore() {
+    const int result = socket_->Write(
+        write_buffer_.get(), write_buffer_->BytesRemaining(),
+        base::BindOnce(&LoopbackWorker::OnWrite, weak_factory_.GetWeakPtr()),
+        TRAFFIC_ANNOTATION_FOR_TESTS);
+    if (result != net::ERR_IO_PENDING) {
+      OnWrite(result);
+    }
+  }
+
+  void OnWrite(int result) {
+    if (result <= 0) {
+      return;
+    }
+    write_buffer_->DidConsume(result);
+    if (write_buffer_->BytesRemaining() > 0) {
+      WriteMore();
+      return;
+    }
+    write_buffer_.reset();
+    StartAccept();
+  }
+
+  const WorkerBehavior behavior_;
+  net::TCPServerSocket server_;
+  net::IPEndPoint endpoint_;
+  std::unique_ptr<net::StreamSocket> socket_;
+  scoped_refptr<net::IOBufferWithSize> read_buffer_;
+  scoped_refptr<net::DrainableIOBuffer> write_buffer_;
+  std::string request_bytes_;
+  std::vector<RemoteGzipperRequest> requests_;
+  size_t waiting_for_request_count_ = 0;
+  base::OnceClosure request_received_;
+  data_decoder::Gzipper gzipper_;
+  base::WeakPtrFactory<LoopbackWorker> weak_factory_{this};
+};
+
+class ScopedLogCapture {
+ public:
+  ScopedLogCapture() {
+    CHECK(!instance_);
+    instance_ = this;
+    previous_handler_ = logging::GetLogMessageHandler();
+    logging::SetLogMessageHandler(&ScopedLogCapture::Capture);
+  }
+
+  ScopedLogCapture(const ScopedLogCapture&) = delete;
+  ScopedLogCapture& operator=(const ScopedLogCapture&) = delete;
+
+  ~ScopedLogCapture() {
+    logging::SetLogMessageHandler(previous_handler_);
+    instance_ = nullptr;
+  }
+
+  bool Contains(std::string_view value) const {
+    return messages_.find(value) != std::string::npos;
+  }
+
+ private:
+  static bool Capture(int severity,
+                      const char* file,
+                      int line,
+                      size_t message_start,
+                      const std::string& message) {
+    instance_->messages_.append(message);
+    return instance_->previous_handler_
+               ? instance_->previous_handler_(severity, file, line,
+                                              message_start, message)
+               : false;
+  }
+
+  static ScopedLogCapture* instance_;
+  logging::LogMessageHandlerFunction previous_handler_ = nullptr;
+  std::string messages_;
+};
+
+ScopedLogCapture* ScopedLogCapture::instance_ = nullptr;
+
+class RemoteDataDecoderServiceIntegrationTest : public testing::Test {
+ public:
+  RemoteDataDecoderServiceIntegrationTest() = default;
+  ~RemoteDataDecoderServiceIntegrationTest() override = default;
+
+ protected:
+  void BindRemote(std::string endpoint, std::string token) {
+    mojo::Remote<DataDecoder> local_service;
+    local_service_ = std::make_unique<LocalDataDecoder>(
+        local_service.BindNewPipeAndPassReceiver());
+    BindRemoteDataDecoderServiceForTesting(
+        remote_service_.BindNewPipeAndPassReceiver(), std::move(endpoint),
+        std::move(token), local_service.Unbind());
+    remote_service_->BindGzipper(remote_gzipper_.BindNewPipeAndPassReceiver());
+  }
+
+  std::string Deflate(std::string_view input) {
+    base::test::TestFuture<std::optional<Buffer>> future;
+    remote_gzipper_->Deflate(ToBuffer(input), future.GetCallback());
+    const std::optional<Buffer>& result = future.Get();
+    CHECK(result);
+    return ToString(*result);
+  }
+
+  BrowserTaskEnvironment task_environment_{
+      BrowserTaskEnvironment::IO_MAINLOOP,
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  std::unique_ptr<LocalDataDecoder> local_service_;
+  mojo::Remote<DataDecoder> remote_service_;
+  mojo::Remote<Gzipper> remote_gzipper_;
+};
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest,
+       RemoteModeDisabledKeepsBrowserRouteLocal) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      "enable-distributed-utility-proxy");
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      "distributed-utility-worker");
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      "distributed-utility-token-file");
+
+  EXPECT_FALSE(ShouldRouteDataDecoderRemotely());
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest,
+       RemoteSuccessMatchesLocalDeflateOutput) {
+  LoopbackWorker worker(WorkerBehavior::kSuccess);
+  const std::string input = "browser-loopback-deflate";
+  BindRemote(worker.endpoint(), "loopback-token");
+
+  EXPECT_EQ(DeflateLocally(input), Deflate(input));
+  worker.WaitForRequests(1);
+  EXPECT_EQ("loopback-token", worker.request(0).authentication_data);
+  EXPECT_EQ(input, worker.request(0).payload);
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest, UnavailableWorkerFallsBack) {
+  BindRemote(UnavailableLoopbackEndpoint(), "loopback-token");
+  EXPECT_EQ(DeflateLocally("unavailable-worker"),
+            Deflate("unavailable-worker"));
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest,
+       AuthenticationFailureFallsBack) {
+  LoopbackWorker worker(WorkerBehavior::kAuthenticationFailure);
+  BindRemote(worker.endpoint(), "loopback-token");
+
+  EXPECT_EQ(DeflateLocally("auth-fallback"), Deflate("auth-fallback"));
+  worker.WaitForRequests(1);
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest, TimeoutFallsBack) {
+  LoopbackWorker worker(WorkerBehavior::kHang);
+  BindRemote(worker.endpoint(), "loopback-token");
+  base::test::TestFuture<std::optional<Buffer>> future;
+  remote_gzipper_->Deflate(ToBuffer("timeout-fallback"), future.GetCallback());
+  worker.WaitForRequests(1);
+  task_environment_.FastForwardBy(base::Seconds(10));
+
+  const std::optional<Buffer>& result = future.Get();
+  ASSERT_TRUE(result);
+  EXPECT_EQ(DeflateLocally("timeout-fallback"), ToString(*result));
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest,
+       MalformedResponseFallsBackWithoutCrashing) {
+  LoopbackWorker worker(WorkerBehavior::kMalformedResponse);
+  BindRemote(worker.endpoint(), "loopback-token");
+
+  EXPECT_EQ(DeflateLocally("malformed-fallback"),
+            Deflate("malformed-fallback"));
+  worker.WaitForRequests(1);
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest, SequentialRequestsWork) {
+  LoopbackWorker worker(WorkerBehavior::kSuccess);
+  BindRemote(worker.endpoint(), "loopback-token");
+
+  EXPECT_EQ(DeflateLocally("first-request"), Deflate("first-request"));
+  EXPECT_EQ(DeflateLocally("second-request"), Deflate("second-request"));
+  worker.WaitForRequests(2);
+  EXPECT_EQ("first-request", worker.request(0).payload);
+  EXPECT_EQ("second-request", worker.request(1).payload);
+}
+
+TEST_F(RemoteDataDecoderServiceIntegrationTest, PayloadsAreNotLogged) {
+  LoopbackWorker worker(WorkerBehavior::kSuccess);
+  constexpr char kPayload[] = "loopback-payload-log-sentinel-7A3F";
+  BindRemote(worker.endpoint(), "loopback-token");
+  ScopedLogCapture log_capture;
+
+  EXPECT_EQ(DeflateLocally(kPayload), Deflate(kPayload));
+  worker.WaitForRequests(1);
+  EXPECT_FALSE(log_capture.Contains(kPayload));
+}
+
