+#ifndef CONTENT_DISTRIBUTED_REMOTE_GZIPPER_CLIENT_H_
+#define CONTENT_DISTRIBUTED_REMOTE_GZIPPER_CLIENT_H_
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "content/distributed/remote_gzipper_protocol.h"
+
+namespace content::distributed {
+
+// Executes one Remote Gzipper protocol exchange on a ThreadPool worker.
+// Network, protocol, and worker failures are returned as nullopt. A failure
+// frame sent by the worker is returned to the caller for local fallback.
+class RemoteGzipperClient {
+ public:
+  using ResponseCallback =
+      base::OnceCallback<void(std::optional<RemoteGzipperResponse>)>;
+
+  RemoteGzipperClient(std::string worker_endpoint,
+                      std::string authentication_data);
+  RemoteGzipperClient(const RemoteGzipperClient&) = delete;
+  RemoteGzipperClient& operator=(const RemoteGzipperClient&) = delete;
+  ~RemoteGzipperClient();
+
+  void Send(RemoteGzipperRequest request, ResponseCallback callback);
+
+ private:
+  const std::string worker_endpoint_;
+  const std::string authentication_data_;
+};
+
+}  // namespace content::distributed
+
+#endif  // CONTENT_DISTRIBUTED_REMOTE_GZIPPER_CLIENT_H_
