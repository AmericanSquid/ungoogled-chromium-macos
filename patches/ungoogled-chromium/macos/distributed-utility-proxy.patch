+#include <string_view>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "net/base/address_list.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/io_buffer.h"
+#include "net/base/net_errors.h"
+#include "net/base/network_anonymization_key.h"
+#include "net/base/network_handle.h"
+#include "net/log/net_log_source.h"
+#include "net/log/net_log_with_source.h"
+#include "net/socket/tcp_client_socket.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace content::distributed {
+
+namespace {
+
+constexpr size_t kResponseReadChunkSize = 16 * 1024;
+constexpr size_t kMaximumResponseSize = 28 + kRemoteGzipperMaxPayloadSize;
+
+struct ParsedWorkerEndpoint {
+  std::string host;
+  uint16_t port;
+};
+
+std::optional<ParsedWorkerEndpoint> ParseWorkerEndpoint(
+    std::string_view worker_endpoint) {
+  const size_t separator = worker_endpoint.rfind(':');
+  if (separator == std::string_view::npos || separator == 0 ||
+      separator + 1 == worker_endpoint.size()) {
+    return std::nullopt;
+  }
+
+  std::string_view host = worker_endpoint.substr(0, separator);
+  if (host.front() == '[' && host.back() == ']') {
+    host.remove_prefix(1);
+    host.remove_suffix(1);
+  } else if (host.find(':') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (host.empty()) {
+    return std::nullopt;
+  }
+
+  const std::string_view port_text = worker_endpoint.substr(separator + 1);
+  uint32_t port_number = 0;
+  for (char character : port_text) {
+    if (character < '0' || character > '9') {
+      return std::nullopt;
+    }
+    const uint32_t digit = character - '0';
+    if (port_number > (65535 - digit) / 10) {
+      return std::nullopt;
+    }
+    port_number = port_number * 10 + digit;
+  }
+  if (port_number == 0) {
+    return std::nullopt;
+  }
+  return ParsedWorkerEndpoint{std::string(host),
+                              static_cast<uint16_t>(port_number)};
+}
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("distributed_utility_proxy", R"(
+      semantics {
+        sender: "Distributed Utility Proxy"
+        description:
+          "Sends an authenticated Gzipper Deflate request to a worker "
+          "explicitly configured by the user on a private network."
+        trigger:
+          "A Gzipper Deflate operation while the distributed utility proxy "
+          "command-line switch, endpoint, and token file are configured."
+        data: "Authentication token and binary Deflate input."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Disabled by default and enabled only with explicit command-line "
+          "configuration."
+        policy_exception_justification:
+          "This experimental fork-only feature has no enterprise policy."
+      })");
+
+}  // namespace
+
+RemoteGzipperClient::RemoteGzipperClient(std::string worker_endpoint,
+                                         std::string authentication_data,
+                                         base::TimeDelta connection_timeout,
+                                         base::TimeDelta request_timeout)
+    : worker_endpoint_text_(std::move(worker_endpoint)),
+      authentication_data_(std::move(authentication_data)),
+      connection_timeout_(connection_timeout),
+      request_timeout_(request_timeout),
+      resolver_(net::HostResolver::CreateStandaloneResolver(nullptr)) {}
+
+RemoteGzipperClient::~RemoteGzipperClient() {
+  ResetOperation();
+}
+
+void RemoteGzipperClient::SetHostResolverForTesting(
+    std::unique_ptr<net::HostResolver> resolver) {
+  CHECK(!request_in_flight_);
+  resolver_ = std::move(resolver);
+}
+
+void RemoteGzipperClient::Send(RemoteGzipperRequest request,
+                               ResponseCallback callback) {
+  if (request_in_flight_) {
+    std::move(callback).Run(
+        RemoteGzipperResult{RemoteGzipperOutcome::kBusy, std::string()});
+    return;
+  }
+  if (request.operation_id !=
+      static_cast<uint8_t>(RemoteGzipperOperation::kDeflate)) {
+    std::move(callback).Run(RemoteGzipperResult{
+        RemoteGzipperOutcome::kUnsupportedOperation, std::string()});
+    return;
+  }
+  if (authentication_data_.empty()) {
+    std::move(callback).Run(RemoteGzipperResult{
+        RemoteGzipperOutcome::kAuthenticationFailure, std::string()});
+    return;
+  }
+
+  const auto endpoint = ParseWorkerEndpoint(worker_endpoint_text_);
+  request.authentication_data = authentication_data_;
+  const auto serialized_request = SerializeRemoteGzipperRequest(request);
+  if (!endpoint || !serialized_request || !resolver_) {
+    std::move(callback).Run(RemoteGzipperResult{
+        RemoteGzipperOutcome::kMalformedResponse, std::string()});
+    return;
+  }
+
+  request_in_flight_ = true;
+  worker_endpoint_ = WorkerEndpoint{endpoint->host, endpoint->port};
+  request_ = std::move(request);
+  callback_ = std::move(callback);
+  auto request_buffer =
+      base::MakeRefCounted<net::StringIOBuffer>(*serialized_request);
+  write_buffer_ = base::MakeRefCounted<net::DrainableIOBuffer>(
+      std::move(request_buffer), serialized_request->size());
+
+  resolve_request_ = resolver_->CreateRequest(
+      net::HostPortPair(worker_endpoint_.host, worker_endpoint_.port),
+      net::NetworkAnonymizationKey(), net::handles::kInvalidNetworkHandle,
+      net::NetLogWithSource(), std::nullopt);
+  connection_timer_.Start(
+      FROM_HERE, connection_timeout_,
+      base::BindOnce(&RemoteGzipperClient::OnConnectionTimeout,
+                     weak_factory_.GetWeakPtr()));
+  const int result = resolve_request_->Start(base::BindOnce(
+      &RemoteGzipperClient::OnResolveComplete, weak_factory_.GetWeakPtr()));
+  if (result != net::ERR_IO_PENDING) {
+    OnResolveComplete(result);
+  }
+}
+
+void RemoteGzipperClient::OnConnectionTimeout() {
+  Finish(RemoteGzipperOutcome::kTimeout);
+}
+
+void RemoteGzipperClient::OnRequestTimeout() {
+  Finish(RemoteGzipperOutcome::kTimeout);
+}
+
+void RemoteGzipperClient::OnResolveComplete(int result) {
+  if (!request_in_flight_) {
+    return;
+  }
+  if (result != net::OK || resolve_request_->GetAddressResults().empty()) {
+    Finish(RemoteGzipperOutcome::kUnavailable);
+    return;
+  }
+  StartConnect();
+}
+
+void RemoteGzipperClient::StartConnect() {
+  const net::AddressList addresses = resolve_request_->GetAddressResults();
+  resolve_request_.reset();
+  socket_ = std::make_unique<net::TCPClientSocket>(
+      addresses, nullptr, nullptr, nullptr, net::NetLogSource(),
+      net::handles::kInvalidNetworkHandle);
+  const int result = socket_->Connect(base::BindOnce(
+      &RemoteGzipperClient::OnConnectComplete, weak_factory_.GetWeakPtr()));
+  if (result != net::ERR_IO_PENDING) {
+    OnConnectComplete(result);
+  }
+}
+
+void RemoteGzipperClient::OnConnectComplete(int result) {
+  if (result != net::OK) {
+    Finish(RemoteGzipperOutcome::kUnavailable);
+    return;
+  }
+  connection_timer_.Stop();
+  request_timer_.Start(FROM_HERE, request_timeout_,
+                       base::BindOnce(&RemoteGzipperClient::OnRequestTimeout,
+                                      weak_factory_.GetWeakPtr()));
+  WriteRequest();
+}
+
+void RemoteGzipperClient::WriteRequest() {
+  const int result =
+      socket_->Write(write_buffer_.get(), write_buffer_->BytesRemaining(),
+                     base::BindOnce(&RemoteGzipperClient::OnWriteComplete,
+                                    weak_factory_.GetWeakPtr()),
+                     kTrafficAnnotation);
+  if (result != net::ERR_IO_PENDING) {
+    OnWriteComplete(result);
+  }
+}
+
+void RemoteGzipperClient::OnWriteComplete(int result) {
+  if (result <= 0) {
+    Finish(RemoteGzipperOutcome::kDisconnect);
+    return;
+  }
+  write_buffer_->DidConsume(result);
+  if (write_buffer_->BytesRemaining() > 0) {
+    WriteRequest();
+    return;
+  }
+  write_buffer_.reset();
+  ReadResponse();
+}
+
+void RemoteGzipperClient::ReadResponse() {
+  read_buffer_ =
+      base::MakeRefCounted<net::IOBufferWithSize>(kResponseReadChunkSize);
+  const int result =
+      socket_->Read(read_buffer_.get(), read_buffer_->size(),
+                    base::BindOnce(&RemoteGzipperClient::OnReadComplete,
+                                   weak_factory_.GetWeakPtr()));
+  if (result != net::ERR_IO_PENDING) {
+    OnReadComplete(result);
+  }
+}
+
+void RemoteGzipperClient::OnReadComplete(int result) {
+  if (result < 0) {
+    Finish(RemoteGzipperOutcome::kDisconnect);
+    return;
+  }
+  if (result == 0) {
+    if (response_bytes_.empty()) {
+      Finish(RemoteGzipperOutcome::kDisconnect);
+      return;
+    }
+    CompleteResponse();
+    return;
+  }
+  const size_t bytes_read = static_cast<size_t>(result);
+  if (bytes_read > kMaximumResponseSize - response_bytes_.size()) {
+    Finish(RemoteGzipperOutcome::kMalformedResponse);
+    return;
+  }
+  response_bytes_.append(read_buffer_->data(), bytes_read);
+  read_buffer_.reset();
+  ReadResponse();
+}
+
+void RemoteGzipperClient::CompleteResponse() {
+  const auto response = ParseRemoteGzipperResponse(response_bytes_);
+  if (!response || !IsRemoteGzipperResponseForRequest(request_, *response)) {
+    Finish(RemoteGzipperOutcome::kMalformedResponse);
+    return;
+  }
+  if (response->status == RemoteGzipperStatus::kSuccess) {
+    Finish(RemoteGzipperOutcome::kSuccess, response->payload);
+    return;
+  }
+  switch (response->error) {
+    case RemoteGzipperError::kMissingAuthentication:
+    case RemoteGzipperError::kAuthenticationFailed:
+      Finish(RemoteGzipperOutcome::kAuthenticationFailure);
+      return;
+    case RemoteGzipperError::kUnsupportedOperation:
+      Finish(RemoteGzipperOutcome::kUnsupportedOperation);
+      return;
+    case RemoteGzipperError::kMalformedFrame:
+    case RemoteGzipperError::kOversizedPayload:
+      Finish(RemoteGzipperOutcome::kMalformedResponse);
+      return;
+    case RemoteGzipperError::kInternal:
+      Finish(RemoteGzipperOutcome::kWorkerFailure);
+      return;
+    case RemoteGzipperError::kNone:
+      Finish(RemoteGzipperOutcome::kMalformedResponse);
+      return;
+  }
+}
+
+void RemoteGzipperClient::Finish(RemoteGzipperOutcome outcome,
+                                 std::string payload) {
+  if (!request_in_flight_) {
+    return;
+  }
+  ResponseCallback callback = std::move(callback_);
+  ResetOperation();
+  std::move(callback).Run(RemoteGzipperResult{outcome, std::move(payload)});
+}
+
+void RemoteGzipperClient::ResetOperation() {
+  weak_factory_.InvalidateWeakPtrs();
+  connection_timer_.Stop();
+  request_timer_.Stop();
+  resolve_request_.reset();
+  if (socket_) {
+    socket_->Disconnect();
+  }
+  socket_.reset();
+  write_buffer_.reset();
+  read_buffer_.reset();
+  response_bytes_.clear();
+  request_ = RemoteGzipperRequest{};
+  request_in_flight_ = false;
+}
+
+}  // namespace content::distributed
