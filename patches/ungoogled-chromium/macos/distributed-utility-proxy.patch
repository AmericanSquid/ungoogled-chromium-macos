+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/distributed_utility_proxy.h"
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+
+namespace content::distributed {
+
+namespace {
+
+constexpr char kDataDecoderServiceName[] =
+    "data_decoder.mojom.DataDecoderService";
+constexpr char kEnableDistributedUtilityProxy[] =
+    "enable-distributed-utility-proxy";
+constexpr char kDistributedUtilityWorker[] = "distributed-utility-worker";
+constexpr char kDistributedUtilityTokenFile[] =
+    "distributed-utility-token-file";
+
+}  // namespace
+
+bool IsRemoteEligibleUtilityService(const std::string& service_name) {
+  return service_name == kDataDecoderServiceName;
+}
+
+bool IsDistributedUtilityProxyEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kEnableDistributedUtilityProxy);
+}
+
+std::string GetDistributedUtilityWorkerEndpoint() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      kDistributedUtilityWorker);
+}
+
+std::string GetDistributedUtilityTokenFile() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      kDistributedUtilityTokenFile);
+}
+
+std::optional<std::string> GetDistributedUtilityToken() {
+  const std::string token_file = GetDistributedUtilityTokenFile();
+  if (token_file.empty()) {
+    return std::nullopt;
+  }
+  std::string token;
+  if (!base::ReadFileToString(base::FilePath::FromUTF8Unsafe(token_file),
+                              &token)) {
+    return std::nullopt;
+  }
+  base::TrimWhitespaceASCII(token, base::TRIM_ALL, &token);
+  return token.empty() ? std::nullopt
+                       : std::make_optional(std::move(token));
+}
+
+bool ShouldRouteDataDecoderRemotely() {
+  return IsDistributedUtilityProxyEnabled() &&
+         !GetDistributedUtilityWorkerEndpoint().empty() &&
+         GetDistributedUtilityToken().has_value();
+}
+
+void LogRemoteDataDecoderFallback(const std::string& worker_endpoint) {
+  LOG(WARNING) << "DISTRIBUTED: remote Data Decoder requested for "
+               << worker_endpoint
+               << "; proxy transport is not implemented yet; using local "
+                  "Data Decoder service";
+}
+
+void LogRemoteEligibleUtilityService(const std::string& service_name) {
+  LOG(INFO) << "DISTRIBUTED: utility service eligible for remote execution: "
+            << service_name;
+}
+
+}  // namespace content::distributed
