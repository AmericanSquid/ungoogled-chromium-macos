+
+#include "content/distributed/remote_gzipper_client.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "base/notreached.h"
+#include "base/run_loop.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "base/time/time.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/net_errors.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/log/net_log_source.h"
+#include "net/socket/stream_socket.h"
+#include "net/socket/tcp_server_socket.h"
+#include "net/traffic_annotation/network_traffic_annotation_test_helper.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace content::distributed {
+namespace {
+
+enum class WorkerBehavior {
+  kSuccess,
+  kDisconnect,
+  kHang,
+  kAuthenticationFailure,
+  kMalformedResponse,
+  kUnsupportedOperation,
+  kMismatchedRequestId,
+};
+
+class LoopbackWorker {
+ public:
+  explicit LoopbackWorker(WorkerBehavior behavior)
+      : behavior_(behavior), server_(nullptr, net::NetLogSource()) {
+    CHECK_EQ(net::OK,
+             server_.Listen(net::IPEndPoint(net::IPAddress::IPv4Localhost(), 0),
+                            1, std::nullopt));
+    CHECK_EQ(net::OK, server_.GetLocalAddress(&endpoint_));
+    const int result = server_.Accept(
+        &socket_,
+        base::BindOnce(&LoopbackWorker::OnAccept, weak_factory_.GetWeakPtr()));
+    CHECK_EQ(net::ERR_IO_PENDING, result);
+  }
+
+  LoopbackWorker(const LoopbackWorker&) = delete;
+  LoopbackWorker& operator=(const LoopbackWorker&) = delete;
+  ~LoopbackWorker() = default;
+
+  std::string endpoint() const { return endpoint_.ToString(); }
+
+  void WaitForRequest() {
+    if (request_) {
+      return;
+    }
+    base::RunLoop run_loop;
+    request_received_ = run_loop.QuitClosure();
+    run_loop.Run();
+  }
+
+  const RemoteGzipperRequest& request() const {
+    CHECK(request_);
+    return *request_;
+  }
+
+ private:
+  void OnAccept(int result) {
+    if (result != net::OK) {
+      return;
+    }
+    if (behavior_ == WorkerBehavior::kDisconnect) {
+      socket_->Disconnect();
+      socket_.reset();
+      return;
+    }
+    ReadRequest();
+  }
+
+  void ReadRequest() {
+    read_buffer_ = base::MakeRefCounted<net::IOBufferWithSize>(4096);
+    const int result = socket_->Read(
+        read_buffer_.get(), read_buffer_->size(),
+        base::BindOnce(&LoopbackWorker::OnRead, weak_factory_.GetWeakPtr()));
+    if (result != net::ERR_IO_PENDING) {
+      OnRead(result);
+    }
+  }
+
+  void OnRead(int result) {
+    if (result <= 0) {
+      return;
+    }
+    request_bytes_.append(read_buffer_->data(), static_cast<size_t>(result));
+    read_buffer_.reset();
+    request_ = ParseRemoteGzipperRequest(request_bytes_);
+    if (!request_) {
+      ReadRequest();
+      return;
+    }
+    if (request_received_) {
+      std::move(request_received_).Run();
+    }
+    if (behavior_ == WorkerBehavior::kHang) {
+      return;
+    }
+    SendResponse();
+  }
+
+  void SendResponse() {
+    if (behavior_ == WorkerBehavior::kMalformedResponse) {
+      WriteResponse("not-a-protocol-frame");
+      return;
+    }
+
+    RemoteGzipperResponse response{request_->request_id,
+                                   RemoteGzipperStatus::kSuccess,
+                                   RemoteGzipperError::kNone, "remote-result"};
+    switch (behavior_) {
+      case WorkerBehavior::kAuthenticationFailure:
+        response = MakeRemoteGzipperFailureResponse(
+            request_->request_id, RemoteGzipperError::kAuthenticationFailed);
+        break;
+      case WorkerBehavior::kUnsupportedOperation:
+        response = MakeRemoteGzipperFailureResponse(
+            request_->request_id, RemoteGzipperError::kUnsupportedOperation);
+        break;
+      case WorkerBehavior::kMismatchedRequestId:
+        ++response.request_id;
+        break;
+      case WorkerBehavior::kSuccess:
+        break;
+      case WorkerBehavior::kDisconnect:
+      case WorkerBehavior::kHang:
+      case WorkerBehavior::kMalformedResponse:
+        NOTREACHED();
+    }
+    const auto serialized = SerializeRemoteGzipperResponse(response);
+    CHECK(serialized);
+    WriteResponse(*serialized);
+  }
+
+  void WriteResponse(std::string response) {
+    auto source =
+        base::MakeRefCounted<net::StringIOBuffer>(std::move(response));
+    const int response_size = source->size();
+    write_buffer_ = base::MakeRefCounted<net::DrainableIOBuffer>(
+        std::move(source), response_size);
+    WriteMore();
+  }
+
+  void WriteMore() {
+    const int result = socket_->Write(
+        write_buffer_.get(), write_buffer_->BytesRemaining(),
+        base::BindOnce(&LoopbackWorker::OnWrite, weak_factory_.GetWeakPtr()),
+        TRAFFIC_ANNOTATION_FOR_TESTS);
+    if (result != net::ERR_IO_PENDING) {
+      OnWrite(result);
+    }
+  }
+
+  void OnWrite(int result) {
+    if (result <= 0) {
+      return;
+    }
+    write_buffer_->DidConsume(result);
+    if (write_buffer_->BytesRemaining() > 0) {
+      WriteMore();
+      return;
+    }
+    socket_->Disconnect();
+    socket_.reset();
+    write_buffer_.reset();
+  }
+
+  const WorkerBehavior behavior_;
+  net::TCPServerSocket server_;
+  net::IPEndPoint endpoint_;
+  std::unique_ptr<net::StreamSocket> socket_;
+  scoped_refptr<net::IOBufferWithSize> read_buffer_;
+  scoped_refptr<net::DrainableIOBuffer> write_buffer_;
+  std::string request_bytes_;
+  std::optional<RemoteGzipperRequest> request_;
+  base::OnceClosure request_received_;
+  base::WeakPtrFactory<LoopbackWorker> weak_factory_{this};
+};
+
+RemoteGzipperRequest MakeClientRequest(uint64_t request_id = 7) {
+  return RemoteGzipperRequest{
+      request_id, static_cast<uint8_t>(RemoteGzipperOperation::kDeflate),
+      "caller-token-is-overwritten", "request-payload"};
+}
+
+class RemoteGzipperClientTest : public testing::Test {
+ protected:
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::IO,
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+};
+
+TEST_F(RemoteGzipperClientTest, SendsConfiguredTokenAndReturnsSuccess) {
+  LoopbackWorker worker(WorkerBehavior::kSuccess);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token");
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  const RemoteGzipperResult& result = future.Get();
+  EXPECT_EQ(RemoteGzipperOutcome::kSuccess, result.outcome);
+  EXPECT_EQ("remote-result", result.payload);
+  worker.WaitForRequest();
+  EXPECT_EQ("configured-token", worker.request().authentication_data);
+  EXPECT_EQ(7u, worker.request().request_id);
+}
+
+TEST_F(RemoteGzipperClientTest, ReportsDisconnect) {
+  LoopbackWorker worker(WorkerBehavior::kDisconnect);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token");
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kDisconnect, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, ReportsUnavailableWorker) {
+  auto resolver = std::make_unique<net::MockHostResolver>();
+  resolver->rules()->AddSimulatedFailure("unavailable.test");
+
+  RemoteGzipperClient client("unavailable.test:8765", "configured-token");
+  client.SetHostResolverForTesting(std::move(resolver));
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kUnavailable, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, ReportsAuthenticationFailure) {
+  LoopbackWorker worker(WorkerBehavior::kAuthenticationFailure);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token");
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kAuthenticationFailure, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, ReportsMalformedResponse) {
+  LoopbackWorker worker(WorkerBehavior::kMalformedResponse);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token");
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kMalformedResponse, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, ReportsUnsupportedOperation) {
+  LoopbackWorker worker(WorkerBehavior::kUnsupportedOperation);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token");
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kUnsupportedOperation, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, RejectsMismatchedRequestId) {
+  LoopbackWorker worker(WorkerBehavior::kMismatchedRequestId);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token");
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kMalformedResponse, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, EnforcesRequestTimeout) {
+  LoopbackWorker worker(WorkerBehavior::kHang);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token",
+                             base::Seconds(1), base::Milliseconds(50));
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+  worker.WaitForRequest();
+  task_environment_.FastForwardBy(base::Milliseconds(50));
+
+  EXPECT_EQ(RemoteGzipperOutcome::kTimeout, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, EnforcesConnectionTimeout) {
+  auto resolver = std::make_unique<net::MockHostResolver>();
+  resolver->set_ondemand_mode(true);
+  resolver->rules()->AddRule("worker.test", "127.0.0.1");
+
+  RemoteGzipperClient client("worker.test:8765", "configured-token",
+                             base::Milliseconds(50), base::Seconds(1));
+  client.SetHostResolverForTesting(std::move(resolver));
+  base::test::TestFuture<RemoteGzipperResult> future;
+
+  client.Send(MakeClientRequest(), future.GetCallback());
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(future.IsReady());
+  task_environment_.FastForwardBy(base::Milliseconds(50));
+
+  EXPECT_EQ(RemoteGzipperOutcome::kTimeout, future.Get().outcome);
+}
+
+TEST_F(RemoteGzipperClientTest, AllowsOnlyOneOutstandingRequest) {
+  LoopbackWorker worker(WorkerBehavior::kHang);
+  RemoteGzipperClient client(worker.endpoint(), "configured-token",
+                             base::Seconds(1), base::Milliseconds(50));
+  base::test::TestFuture<RemoteGzipperResult> first;
+  base::test::TestFuture<RemoteGzipperResult> second;
+
+  client.Send(MakeClientRequest(7), first.GetCallback());
+  worker.WaitForRequest();
+  client.Send(MakeClientRequest(8), second.GetCallback());
+
+  EXPECT_EQ(RemoteGzipperOutcome::kBusy, second.Get().outcome);
+  EXPECT_TRUE(client.request_in_flight_for_testing());
+  task_environment_.FastForwardBy(base::Milliseconds(50));
+  EXPECT_EQ(RemoteGzipperOutcome::kTimeout, first.Get().outcome);
+  EXPECT_FALSE(client.request_in_flight_for_testing());
+}
+
