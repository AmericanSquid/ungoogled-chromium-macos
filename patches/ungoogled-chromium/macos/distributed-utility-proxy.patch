+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/distributed_utility_proxy.h"
+
+#include <atomic>
+#include <cstring>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "content/distributed/remote_gzipper_client.h"
+#include "content/public/browser/service_process_host.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace content::distributed {
+namespace {
+using DataDecoder = data_decoder::mojom::DataDecoderService;
+using Gzipper = data_decoder::mojom::Gzipper;
+using Buffer = mojo_base::BigBuffer;
+using Result = std::optional<Buffer>;
+std::atomic<uint64_t> next_id{1};
+
+Buffer ToBuffer(const std::string& data) {
+  Buffer result(data.size());
+  if (!data.empty())
+    std::memcpy(result.data(), data.data(), data.size());
+  return result;
+}
+std::string ToString(const Buffer& data) {
+  return std::string(static_cast<const char*>(data.data()), data.size());
+}
+
+class RemoteGzipper final : public Gzipper {
+ public:
+  RemoteGzipper(std::string endpoint,
+                std::string authentication_data,
+                mojo::PendingReceiver<Gzipper> receiver)
+      : receiver_(this, std::move(receiver)),
+        client_(std::move(endpoint), std::move(authentication_data)) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&RemoteGzipper::DeleteThis, base::Unretained(this)));
+    ServiceProcessHost::Launch(
+        local_service_.BindNewPipeAndPassReceiver(),
+        ServiceProcessHost::Options().WithDisplayName(
+            "Data Decoder Service (Gzipper fallback)").Pass());
+    local_service_->BindGzipper(
+        local_gzipper_.BindNewPipeAndPassReceiver());
+  }
+  void Deflate(Buffer data, DeflateCallback callback) override {
+    Start(ToString(data), std::move(callback));
+  }
+  void Inflate(Buffer data, uint64_t limit, InflateCallback callback) override {
+    local_gzipper_->Inflate(std::move(data), limit, std::move(callback));
+  }
+  void Compress(Buffer data, CompressCallback callback) override {
+    local_gzipper_->Compress(std::move(data), std::move(callback));
+  }
+  void Uncompress(Buffer data, UncompressCallback callback) override {
+    local_gzipper_->Uncompress(std::move(data), std::move(callback));
+  }
+
+ private:
+  using Callback = base::OnceCallback<void(Result)>;
+  ~RemoteGzipper() override = default;
+  void DeleteThis() { delete this; }
+  void Start(std::string data, Callback callback) {
+    RemoteGzipperRequest request{next_id.fetch_add(1),
+                                  static_cast<uint8_t>(
+                                      RemoteGzipperOperation::kDeflate),
+                                  std::string(), data};
+    client_.Send(std::move(request), base::BindOnce(
+        &RemoteGzipper::Complete, base::Unretained(this), std::move(data),
+        std::move(callback)));
+  }
+  void Complete(std::string data, Callback callback,
+                std::optional<RemoteGzipperResponse> response) {
+    if (response && response->status == RemoteGzipperStatus::kSuccess) {
+      std::move(callback).Run(ToBuffer(response->payload));
+      return;
+    }
+    local_gzipper_->Deflate(ToBuffer(data), std::move(callback));
+  }
+  mojo::Receiver<Gzipper> receiver_;
+  mojo::Remote<DataDecoder> local_service_;
+  mojo::Remote<Gzipper> local_gzipper_;
+  RemoteGzipperClient client_;
+};
+
+class RemoteDataDecoder final : public DataDecoder {
+ public:
+  RemoteDataDecoder(std::string endpoint,
+                    std::string authentication_data,
+                    mojo::PendingReceiver<DataDecoder> receiver)
+      : receiver_(this, std::move(receiver)),
+        endpoint_(std::move(endpoint)),
+        authentication_data_(std::move(authentication_data)) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&RemoteDataDecoder::DeleteThis, base::Unretained(this)));
+    ServiceProcessHost::Launch(
+        local_service_.BindNewPipeAndPassReceiver(),
+        ServiceProcessHost::Options().WithDisplayName(
+            "Data Decoder Service (local fallback)").Pass());
+  }
+  void BindImageDecoder(
+      mojo::PendingReceiver<data_decoder::mojom::ImageDecoder> r) override {
+    local_service_->BindImageDecoder(std::move(r));
+  }
+  void BindXmlParser(
+      mojo::PendingReceiver<data_decoder::mojom::XmlParser> r) override {
+    local_service_->BindXmlParser(std::move(r));
+  }
+  void BindWebBundleParserFactory(
+      mojo::PendingReceiver<web_package::mojom::WebBundleParserFactory> r)
+      override { local_service_->BindWebBundleParserFactory(std::move(r)); }
+  void BindGzipper(mojo::PendingReceiver<Gzipper> r) override {
+    new RemoteGzipper(endpoint_, authentication_data_, std::move(r));
+  }
+  void BindStructuredHeadersParser(
+      mojo::PendingReceiver<data_decoder::mojom::StructuredHeadersParser> r)
+      override { local_service_->BindStructuredHeadersParser(std::move(r)); }
+  void BindCborParser(
+      mojo::PendingReceiver<data_decoder::mojom::CborParser> r) override {
+    local_service_->BindCborParser(std::move(r));
+  }
+  void BindPixCodeValidator(
+      mojo::PendingReceiver<payments::facilitated::mojom::PixCodeValidator> r)
+      override { local_service_->BindPixCodeValidator(std::move(r)); }
+ private:
+  ~RemoteDataDecoder() override = default;
+  void DeleteThis() { delete this; }
+  mojo::Receiver<DataDecoder> receiver_;
+  mojo::Remote<DataDecoder> local_service_;
+  const std::string endpoint_;
+  const std::string authentication_data_;
+};
+}  // namespace
+
+void BindRemoteDataDecoderService(
+    mojo::PendingReceiver<data_decoder::mojom::DataDecoderService> receiver,
+    std::string worker_endpoint,
+    std::string authentication_data) {
+  new RemoteDataDecoder(std::move(worker_endpoint),
+                        std::move(authentication_data), std::move(receiver));
+}
+
+}  // namespace content::distributed
