+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/remote_gzipper_client.h"
+
+#include <array>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_POSIX)
+#include <netdb.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#endif
+
+namespace content::distributed {
+
+namespace {
+
+constexpr size_t kResponseHeaderSize = 24;
+constexpr size_t kResponseReadChunkSize = 16 * 1024;
+constexpr int kSocketTimeoutSeconds = 10;
+
+struct WorkerEndpoint {
+  std::string host;
+  std::string port;
+};
+
+std::optional<WorkerEndpoint> ParseWorkerEndpoint(
+    std::string_view worker_endpoint) {
+  const size_t separator = worker_endpoint.rfind(':');
+  if (separator == std::string_view::npos || separator == 0 ||
+      separator + 1 == worker_endpoint.size()) {
+    return std::nullopt;
+  }
+
+  std::string_view host = worker_endpoint.substr(0, separator);
+  if (host.front() == '[' && host.back() == ']') {
+    host.remove_prefix(1);
+    host.remove_suffix(1);
+  } else if (host.find(':') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (host.empty()) {
+    return std::nullopt;
+  }
+
+  const std::string_view port = worker_endpoint.substr(separator + 1);
+  uint32_t port_number = 0;
+  for (char character : port) {
+    if (character < '0' || character > '9') {
+      return std::nullopt;
+    }
+    const uint32_t digit = character - '0';
+    if (port_number > (65535 - digit) / 10) {
+      return std::nullopt;
+    }
+    port_number = port_number * 10 + digit;
+  }
+  if (port_number == 0) {
+    return std::nullopt;
+  }
+  return WorkerEndpoint{std::string(host), std::string(port)};
+}
+
+#if BUILDFLAG(IS_POSIX)
+
+class ScopedSocket {
+ public:
+  explicit ScopedSocket(int descriptor) : descriptor_(descriptor) {}
+  ScopedSocket(const ScopedSocket&) = delete;
+  ScopedSocket& operator=(const ScopedSocket&) = delete;
+  ScopedSocket(ScopedSocket&& other) noexcept
+      : descriptor_(std::exchange(other.descriptor_, -1)) {}
+  ScopedSocket& operator=(ScopedSocket&& other) noexcept {
+    if (this != &other) {
+      if (descriptor_ >= 0) {
+        close(descriptor_);
+      }
+      descriptor_ = std::exchange(other.descriptor_, -1);
+    }
+    return *this;
+  }
+  ~ScopedSocket() {
+    if (descriptor_ >= 0) {
+      close(descriptor_);
+    }
+  }
+
+  int get() const { return descriptor_; }
+
+ private:
+  int descriptor_;
+};
+
+bool SetSocketTimeout(int descriptor) {
+  timeval timeout = {};
+  timeout.tv_sec = kSocketTimeoutSeconds;
+  if (setsockopt(descriptor, SOL_SOCKET, SO_RCVTIMEO, &timeout,
+                 sizeof(timeout)) != 0 ||
+      setsockopt(descriptor, SOL_SOCKET, SO_SNDTIMEO, &timeout,
+                 sizeof(timeout)) != 0) {
+    return false;
+  }
+#if BUILDFLAG(IS_MAC)
+  const int enabled = 1;
+  if (setsockopt(descriptor, SOL_SOCKET, SO_NOSIGPIPE, &enabled,
+                 sizeof(enabled)) != 0) {
+    return false;
+  }
+#endif
+  return true;
+}
+
+std::optional<ScopedSocket> ConnectToWorker(const WorkerEndpoint& endpoint) {
+  addrinfo hints = {};
+  hints.ai_family = AF_UNSPEC;
+  hints.ai_socktype = SOCK_STREAM;
+  hints.ai_flags = AI_NUMERICSERV;
+
+  addrinfo* addresses = nullptr;
+  if (getaddrinfo(endpoint.host.c_str(), endpoint.port.c_str(), &hints,
+                  &addresses) != 0) {
+    return std::nullopt;
+  }
+
+  for (addrinfo* address = addresses; address; address = address->ai_next) {
+    const int descriptor = socket(address->ai_family, address->ai_socktype,
+                                  address->ai_protocol);
+    if (descriptor < 0) {
+      continue;
+    }
+    ScopedSocket candidate(descriptor);
+    if (!SetSocketTimeout(candidate.get()) ||
+        connect(candidate.get(), address->ai_addr, address->ai_addrlen) != 0) {
+      continue;
+    }
+    freeaddrinfo(addresses);
+    return std::move(candidate);
+  }
+  freeaddrinfo(addresses);
+  return std::nullopt;
+}
+
+bool WriteAll(int descriptor, std::string_view data) {
+  size_t offset = 0;
+  while (offset < data.size()) {
+    const ssize_t written =
+        send(descriptor, data.data() + offset, data.size() - offset, 0);
+    if (written <= 0) {
+      return false;
+    }
+    offset += written;
+  }
+  return true;
+}
+
+std::optional<std::string> ReadResponse(int descriptor) {
+  std::string response;
+  std::array<char, kResponseReadChunkSize> buffer;
+  constexpr size_t kMaxResponseSize =
+      kResponseHeaderSize + kRemoteGzipperMaxPayloadSize;
+  while (true) {
+    const ssize_t bytes_read = recv(descriptor, buffer.data(), buffer.size(), 0);
+    if (bytes_read == 0) {
+      return response;
+    }
+    if (bytes_read < 0) {
+      return std::nullopt;
+    }
+    const size_t bytes_read_size = static_cast<size_t>(bytes_read);
+    if (bytes_read_size > kMaxResponseSize - response.size()) {
+      return std::nullopt;
+    }
+    response.append(buffer.data(), bytes_read);
+  }
+}
+
+#endif  // BUILDFLAG(IS_POSIX)
+
+std::optional<RemoteGzipperFrame> ExchangeWithWorker(
+    std::string worker_endpoint,
+    RemoteGzipperFrame request) {
+  const auto endpoint = ParseWorkerEndpoint(worker_endpoint);
+  const auto serialized_request = SerializeRemoteGzipperFrame(request);
+  if (!endpoint || !serialized_request ||
+      request.message_type != RemoteGzipperMessageType::kRequest) {
+    return std::nullopt;
+  }
+
+#if BUILDFLAG(IS_POSIX)
+  const auto socket = ConnectToWorker(*endpoint);
+  if (!socket || !WriteAll(socket->get(), *serialized_request)) {
+    return std::nullopt;
+  }
+  const auto serialized_response = ReadResponse(socket->get());
+  if (!serialized_response) {
+    return std::nullopt;
+  }
+  const auto response = ParseRemoteGzipperFrame(*serialized_response);
+  if (!response ||
+      (response->message_type != RemoteGzipperMessageType::kSuccess &&
+       response->message_type != RemoteGzipperMessageType::kFailure) ||
+      response->operation != request.operation ||
+      response->request_id != request.request_id) {
+    return std::nullopt;
+  }
+  return response;
+#else
+  return std::nullopt;
+#endif
+}
+
+}  // namespace
+
+RemoteGzipperClient::RemoteGzipperClient(std::string worker_endpoint)
+    : worker_endpoint_(std::move(worker_endpoint)) {}
+
+RemoteGzipperClient::~RemoteGzipperClient() = default;
+
+void RemoteGzipperClient::Send(RemoteGzipperFrame request,
+                               ResponseCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&ExchangeWithWorker, worker_endpoint_, std::move(request)),
+      std::move(callback));
+}
+
+}  // namespace content::distributed
