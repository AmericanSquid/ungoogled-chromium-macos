+#ifndef CONTENT_DISTRIBUTED_REMOTE_GZIPPER_WORKER_H_
+#define CONTENT_DISTRIBUTED_REMOTE_GZIPPER_WORKER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "net/base/ip_endpoint.h"
+
+namespace net {
+class StreamSocket;
+class TCPServerSocket;
+}  // namespace net
+
+namespace content::distributed {
+
+// Linux server for authenticated protocol-v1 Gzipper::Deflate requests. The
+// listener and accepted connection use Chromium asynchronous networking APIs.
+// It intentionally processes one connection at a time.
+class RemoteGzipperWorker {
+ public:
+  explicit RemoteGzipperWorker(std::string authentication_data);
+  RemoteGzipperWorker(const RemoteGzipperWorker&) = delete;
+  RemoteGzipperWorker& operator=(const RemoteGzipperWorker&) = delete;
+  ~RemoteGzipperWorker();
+
+  bool Start(const net::IPEndPoint& listen_endpoint);
+  void Shutdown();
+
+  bool GetLocalAddressForTesting(net::IPEndPoint* endpoint) const;
+
+ private:
+  class Connection;
+
+  void AcceptNextConnection();
+  void OnAccept(int result);
+  void OnConnectionComplete();
+
+  const std::string authentication_data_;
+  std::unique_ptr<net::TCPServerSocket> server_socket_;
+  std::unique_ptr<net::StreamSocket> accepted_socket_;
+  std::unique_ptr<Connection> connection_;
+  base::WeakPtrFactory<RemoteGzipperWorker> weak_factory_{this};
+};
+
+}  // namespace content::distributed
+
+#endif  // CONTENT_DISTRIBUTED_REMOTE_GZIPPER_WORKER_H_
