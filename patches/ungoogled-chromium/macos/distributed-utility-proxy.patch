+#include "net/base/ip_endpoint.h"
+
+namespace {
+
+constexpr char kListenHostSwitch[] = "listen-host";
+constexpr char kListenPortSwitch[] = "listen-port";
+constexpr char kTokenFileSwitch[] = "token-file";
+
+volatile sig_atomic_t g_shutdown_signal_fd = -1;
+
+void HandleShutdownSignal(int signal) {
+  const int saved_errno = errno;
+  const int fd = g_shutdown_signal_fd;
+  if (fd >= 0) {
+    const uint8_t value = static_cast<uint8_t>(signal);
+    const ssize_t result = write(fd, &value, sizeof(value));
+    static_cast<void>(result);
+  }
+  errno = saved_errno;
+}
+
+void OnShutdownSignalReadable(int fd, base::RepeatingClosure quit) {
+  std::array<uint8_t, 16> buffer;
+  while (read(fd, buffer.data(), buffer.size()) > 0) {
+  }
+  quit.Run();
+}
+
+bool InstallSignalHandler(int signal, struct sigaction* previous) {
+  struct sigaction action = {};
+  action.sa_handler = &HandleShutdownSignal;
+  sigemptyset(&action.sa_mask);
+  return sigaction(signal, &action, previous) == 0;
+}
+
+std::string ReadAuthenticationToken(const base::FilePath& path) {
+  std::string token;
+  if (path.empty() || !base::ReadFileToString(path, &token)) {
+    return std::string();
+  }
+  base::TrimWhitespaceASCII(token, base::TRIM_ALL, &token);
+  return token;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::AtExitManager at_exit_manager;
+  base::CommandLine::Init(argc, argv);
+  base::SingleThreadTaskExecutor task_executor(base::MessagePumpType::IO);
+
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  const std::string listen_host =
+      command_line.GetSwitchValueASCII(kListenHostSwitch);
+  const std::string port_text =
+      command_line.GetSwitchValueASCII(kListenPortSwitch);
+  const base::FilePath token_file =
+      command_line.GetSwitchValuePath(kTokenFileSwitch);
+
+  unsigned int port = 0;
+  net::IPAddress address;
+  if (!address.AssignFromIPLiteral(listen_host) || address.IsZero() ||
+      !base::StringToUint(port_text, &port) || port == 0 || port > 65535) {
+    LOG(ERROR) << "Specify a non-wildcard IP and valid port with --"
+               << kListenHostSwitch << " and --" << kListenPortSwitch;
+    return 2;
+  }
+
+  std::string token = ReadAuthenticationToken(token_file);
+  if (token.empty()) {
+    LOG(ERROR) << "A readable, non-empty --" << kTokenFileSwitch
+               << " is required";
+    return 2;
+  }
+
+  std::array<int, 2> signal_pipe;
+  if (pipe2(signal_pipe.data(), O_CLOEXEC | O_NONBLOCK) != 0) {
+    LOG(ERROR) << "Unable to create shutdown signal pipe";
+    return 1;
+  }
+  base::ScopedFD signal_read_fd(signal_pipe[0]);
+  base::ScopedFD signal_write_fd(signal_pipe[1]);
+
+  struct sigaction previous_sigterm = {};
+  struct sigaction previous_sigint = {};
+  if (!InstallSignalHandler(SIGTERM, &previous_sigterm) ||
+      !InstallSignalHandler(SIGINT, &previous_sigint)) {
+    sigaction(SIGTERM, &previous_sigterm, nullptr);
+    LOG(ERROR) << "Unable to install shutdown signal handlers";
+    return 1;
+  }
+  g_shutdown_signal_fd = signal_write_fd.get();
+
+  base::RunLoop run_loop;
+  auto signal_watcher = base::FileDescriptorWatcher::WatchReadable(
+      signal_read_fd.get(),
+      base::BindRepeating(&OnShutdownSignalReadable, signal_read_fd.get(),
+                          run_loop.QuitClosure()));
+
+  content::distributed::RemoteGzipperWorker worker(std::move(token));
+  if (!worker.Start(net::IPEndPoint(address, static_cast<uint16_t>(port)))) {
+    signal_watcher.reset();
+    g_shutdown_signal_fd = -1;
+    sigaction(SIGTERM, &previous_sigterm, nullptr);
+    sigaction(SIGINT, &previous_sigint, nullptr);
+    LOG(ERROR) << "Unable to start distributed utility worker";
+    return 1;
+  }
+
+  LOG(INFO) << "Distributed utility worker listening on " << listen_host << ':'
+            << port;
+  run_loop.Run();
+
+  worker.Shutdown();
+  signal_watcher.reset();
+  g_shutdown_signal_fd = -1;
+  sigaction(SIGTERM, &previous_sigterm, nullptr);
+  sigaction(SIGINT, &previous_sigint, nullptr);
+  return 0;
+}
