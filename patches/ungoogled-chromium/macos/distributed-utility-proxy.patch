+#ifndef CONTENT_DISTRIBUTED_REMOTE_GZIPPER_CLIENT_H_
+#define CONTENT_DISTRIBUTED_REMOTE_GZIPPER_CLIENT_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "content/distributed/remote_gzipper_protocol.h"
+#include "net/dns/host_resolver.h"
+
+namespace net {
+class DrainableIOBuffer;
+class IOBufferWithSize;
+class StreamSocket;
+}  // namespace net
+
+namespace content::distributed {
+
+enum class RemoteGzipperOutcome {
+  kSuccess,
+  kTimeout,
+  kUnavailable,
+  kDisconnect,
+  kAuthenticationFailure,
+  kMalformedResponse,
+  kUnsupportedOperation,
+  kWorkerFailure,
+  kBusy,
+};
+
+struct RemoteGzipperResult {
+  RemoteGzipperOutcome outcome;
+  std::string payload;
+};
+
+// Performs one fully asynchronous remote Gzipper exchange. All DNS, connect,
+// write, and read work uses Chromium net APIs on the calling sequence.
+class RemoteGzipperClient {
+ public:
+  using ResponseCallback = base::OnceCallback<void(RemoteGzipperResult)>;
+
+  RemoteGzipperClient(std::string worker_endpoint,
+                      std::string authentication_data,
+                      base::TimeDelta connection_timeout = base::Seconds(10),
+                      base::TimeDelta request_timeout = base::Seconds(10));
+  RemoteGzipperClient(const RemoteGzipperClient&) = delete;
+  RemoteGzipperClient& operator=(const RemoteGzipperClient&) = delete;
+  ~RemoteGzipperClient();
+
+  void Send(RemoteGzipperRequest request, ResponseCallback callback);
+  bool request_in_flight_for_testing() const { return request_in_flight_; }
+  void SetHostResolverForTesting(std::unique_ptr<net::HostResolver> resolver);
+
+ private:
+  struct WorkerEndpoint {
+    std::string host;
+    uint16_t port;
+  };
+
+  void OnConnectionTimeout();
+  void OnRequestTimeout();
+  void OnResolveComplete(int result);
+  void StartConnect();
+  void OnConnectComplete(int result);
+  void WriteRequest();
+  void OnWriteComplete(int result);
+  void ReadResponse();
+  void OnReadComplete(int result);
+  void CompleteResponse();
+  void Finish(RemoteGzipperOutcome outcome, std::string payload = {});
+  void ResetOperation();
+
+  const std::string worker_endpoint_text_;
+  const std::string authentication_data_;
+  const base::TimeDelta connection_timeout_;
+  const base::TimeDelta request_timeout_;
+
+  bool request_in_flight_ = false;
+  WorkerEndpoint worker_endpoint_;
+  RemoteGzipperRequest request_;
+  ResponseCallback callback_;
+  std::unique_ptr<net::HostResolver> resolver_;
+  std::unique_ptr<net::HostResolver::ResolveHostRequest> resolve_request_;
+  std::unique_ptr<net::StreamSocket> socket_;
+  scoped_refptr<net::DrainableIOBuffer> write_buffer_;
+  scoped_refptr<net::IOBufferWithSize> read_buffer_;
+  std::string response_bytes_;
+  base::OneShotTimer connection_timer_;
+  base::OneShotTimer request_timer_;
+  base::WeakPtrFactory<RemoteGzipperClient> weak_factory_{this};
+};
+
+}  // namespace content::distributed
+
+#endif  // CONTENT_DISTRIBUTED_REMOTE_GZIPPER_CLIENT_H_
