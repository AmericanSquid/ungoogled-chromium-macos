+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/distributed_utility_proxy.h"
+
+#include "base/logging.h"
+
+namespace content::distributed {
+
+namespace {
+
+constexpr char kDataDecoderServiceName[] =
+    "data_decoder.mojom.DataDecoderService";
+
+}  // namespace
+
+bool IsRemoteEligibleUtilityService(const std::string& service_name) {
+  return service_name == kDataDecoderServiceName;
+}
+
+void LogRemoteEligibleUtilityService(const std::string& service_name) {
+  LOG(INFO) << "DISTRIBUTED: utility service eligible for remote execution: "
+            << service_name;
+}
+
+}  // namespace content::distributed
