+#include "content/distributed/remote_gzipper_protocol.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace content::distributed {
+namespace {
+
+TEST(RemoteGzipperProtocolTest, RoundTripsRequestFrame) {
+  RemoteGzipperFrame frame{RemoteGzipperMessageType::kRequest,
+                           RemoteGzipperOperation::kDeflate, 42, "payload"};
+  const auto serialized = SerializeRemoteGzipperFrame(frame);
+  ASSERT_TRUE(serialized);
+
+  const auto parsed = ParseRemoteGzipperFrame(*serialized);
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(RemoteGzipperMessageType::kRequest, parsed->message_type);
+  EXPECT_EQ(RemoteGzipperOperation::kDeflate, parsed->operation);
+  EXPECT_EQ(42u, parsed->request_id);
+  EXPECT_EQ("payload", parsed->payload);
+}
+
+TEST(RemoteGzipperProtocolTest, RejectsTrailingBytes) {
+  RemoteGzipperFrame frame{RemoteGzipperMessageType::kSuccess,
+                           RemoteGzipperOperation::kCompress, 7, "result"};
+  auto serialized = SerializeRemoteGzipperFrame(frame);
+  ASSERT_TRUE(serialized);
+  serialized->push_back('x');
+  EXPECT_FALSE(ParseRemoteGzipperFrame(*serialized));
+}
+
+TEST(RemoteGzipperProtocolTest, RejectsZeroRequestId) {
+  RemoteGzipperFrame frame{RemoteGzipperMessageType::kRequest,
+                           RemoteGzipperOperation::kUncompress, 0, "input"};
+  EXPECT_FALSE(SerializeRemoteGzipperFrame(frame));
+}
+
+TEST(RemoteGzipperProtocolTest, InflatePayloadPrefixesOutputLimit) {
+  const auto payload = MakeRemoteGzipperInflatePayload(513, "compressed");
+  ASSERT_TRUE(payload);
+  ASSERT_EQ(8u + std::string_view("compressed").size(), payload->size());
+  EXPECT_EQ(0, static_cast<unsigned char>((*payload)[6]));
+  EXPECT_EQ(2, static_cast<unsigned char>((*payload)[7]));
+  EXPECT_EQ("compressed", payload->substr(8));
+}
+
