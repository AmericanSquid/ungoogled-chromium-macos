diff --git a/content/distributed/remote_gzipper_protocol.cc b/content/distributed/remote_gzipper_protocol.cc
new file mode 100644
index 00000000..323672e6
--- /dev/null
+++ b/content/distributed/remote_gzipper_protocol.cc
@@ -0,0 +1,228 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/remote_gzipper_protocol.h"
+
+namespace content::distributed {
+
+namespace {
+
+constexpr char kMagic[] = "UCD1";
+constexpr uint16_t kProtocolVersion = 1;
+constexpr size_t kResponseHeaderSize = 28;
+
+void AppendUint16(uint16_t value, std::string* output) {
+  output->push_back(static_cast<char>((value >> 8) & 0xff));
+  output->push_back(static_cast<char>(value & 0xff));
+}
+
+void AppendUint32(uint32_t value, std::string* output) {
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    output->push_back(static_cast<char>((value >> shift) & 0xff));
+  }
+}
+
+void AppendUint64(uint64_t value, std::string* output) {
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    output->push_back(static_cast<char>((value >> shift) & 0xff));
+  }
+}
+
+uint16_t ReadUint16(std::string_view input, size_t offset) {
+  return (static_cast<uint16_t>(static_cast<unsigned char>(input[offset]))
+          << 8) |
+         static_cast<unsigned char>(input[offset + 1]);
+}
+
+uint32_t ReadUint32(std::string_view input, size_t offset) {
+  uint32_t value = 0;
+  for (size_t index = 0; index < sizeof(value); ++index) {
+    value = (value << 8) | static_cast<unsigned char>(input[offset + index]);
+  }
+  return value;
+}
+
+uint64_t ReadUint64(std::string_view input, size_t offset) {
+  uint64_t value = 0;
+  for (size_t index = 0; index < sizeof(value); ++index) {
+    value = (value << 8) | static_cast<unsigned char>(input[offset + index]);
+  }
+  return value;
+}
+
+bool IsValidStatus(RemoteGzipperStatus status) {
+  return status == RemoteGzipperStatus::kSuccess ||
+         status == RemoteGzipperStatus::kFailure;
+}
+
+bool IsValidError(RemoteGzipperError error) {
+  return error >= RemoteGzipperError::kNone &&
+         error <= RemoteGzipperError::kInternal;
+}
+
+}  // namespace
+
+std::optional<std::string> SerializeRemoteGzipperRequest(
+    const RemoteGzipperRequest& request) {
+  if (request.request_id == 0 || request.authentication_data.empty() ||
+      request.authentication_data.size() >
+          kRemoteGzipperMaxAuthenticationDataSize ||
+      request.payload.size() > kRemoteGzipperMaxPayloadSize) {
+    return std::nullopt;
+  }
+
+  std::string output;
+  output.reserve(kRemoteGzipperRequestHeaderSize +
+                 request.authentication_data.size() + request.payload.size());
+  output.append(kMagic, sizeof(kMagic) - 1);
+  AppendUint16(kProtocolVersion, &output);
+  output.push_back(static_cast<char>(request.operation_id));
+  output.push_back(0);
+  AppendUint64(request.request_id, &output);
+  AppendUint32(request.authentication_data.size(), &output);
+  AppendUint64(request.payload.size(), &output);
+  output.append(request.authentication_data);
+  output.append(request.payload);
+  return output;
+}
+
+std::optional<RemoteGzipperRequest> ParseRemoteGzipperRequest(
+    std::string_view serialized_request) {
+  const auto frame_info = InspectRemoteGzipperRequestFrame(serialized_request);
+  if (frame_info.state != RemoteGzipperFrameState::kComplete) {
+    return std::nullopt;
+  }
+
+  const uint32_t authentication_size = ReadUint32(serialized_request, 16);
+  return RemoteGzipperRequest{
+      frame_info.request_id, static_cast<uint8_t>(serialized_request[6]),
+      std::string(serialized_request.substr(kRemoteGzipperRequestHeaderSize,
+                                            authentication_size)),
+      std::string(serialized_request.substr(kRemoteGzipperRequestHeaderSize +
+                                            authentication_size))};
+}
+
+RemoteGzipperRequestFrameInfo InspectRemoteGzipperRequestFrame(
+    std::string_view serialized_request) {
+  if (serialized_request.size() < kRemoteGzipperRequestHeaderSize) {
+    return {RemoteGzipperFrameState::kIncomplete, 0, 0};
+  }
+
+  const uint64_t request_id = ReadUint64(serialized_request, 8);
+  if (serialized_request.substr(0, 4) != std::string_view(kMagic, 4) ||
+      ReadUint16(serialized_request, 4) != kProtocolVersion ||
+      serialized_request[7] != 0 || request_id == 0) {
+    return {RemoteGzipperFrameState::kMalformed, request_id, 0};
+  }
+
+  const uint32_t authentication_size = ReadUint32(serialized_request, 16);
+  const uint64_t payload_size = ReadUint64(serialized_request, 20);
+  if (payload_size > kRemoteGzipperMaxPayloadSize) {
+    return {RemoteGzipperFrameState::kOversized, request_id, 0};
+  }
+  if (authentication_size > kRemoteGzipperMaxAuthenticationDataSize) {
+    return {RemoteGzipperFrameState::kMalformed, request_id, 0};
+  }
+
+  const size_t frame_size = kRemoteGzipperRequestHeaderSize +
+                            authentication_size +
+                            static_cast<size_t>(payload_size);
+  if (serialized_request.size() < frame_size) {
+    return {RemoteGzipperFrameState::kIncomplete, request_id, frame_size};
+  }
+  if (serialized_request.size() > frame_size) {
+    return {RemoteGzipperFrameState::kMalformed, request_id, frame_size};
+  }
+  return {RemoteGzipperFrameState::kComplete, request_id, frame_size};
+}
+
+std::optional<std::string> SerializeRemoteGzipperResponse(
+    const RemoteGzipperResponse& response) {
+  if (response.request_id == 0 || !IsValidStatus(response.status) ||
+      !IsValidError(response.error) ||
+      response.payload.size() > kRemoteGzipperMaxPayloadSize ||
+      (response.status == RemoteGzipperStatus::kSuccess &&
+       response.error != RemoteGzipperError::kNone) ||
+      (response.status == RemoteGzipperStatus::kFailure &&
+       response.error == RemoteGzipperError::kNone)) {
+    return std::nullopt;
+  }
+
+  std::string output;
+  output.reserve(kResponseHeaderSize + response.payload.size());
+  output.append(kMagic, sizeof(kMagic) - 1);
+  AppendUint16(kProtocolVersion, &output);
+  output.push_back(static_cast<char>(response.status));
+  output.push_back(0);
+  AppendUint64(response.request_id, &output);
+  AppendUint32(static_cast<uint32_t>(response.error), &output);
+  AppendUint64(response.payload.size(), &output);
+  output.append(response.payload);
+  return output;
+}
+
+std::optional<RemoteGzipperResponse> ParseRemoteGzipperResponse(
+    std::string_view serialized_response) {
+  if (serialized_response.size() < kResponseHeaderSize ||
+      serialized_response.substr(0, 4) != std::string_view(kMagic, 4) ||
+      ReadUint16(serialized_response, 4) != kProtocolVersion ||
+      serialized_response[7] != 0) {
+    return std::nullopt;
+  }
+
+  const auto status = static_cast<RemoteGzipperStatus>(
+      static_cast<unsigned char>(serialized_response[6]));
+  const uint64_t request_id = ReadUint64(serialized_response, 8);
+  const auto error =
+      static_cast<RemoteGzipperError>(ReadUint32(serialized_response, 16));
+  const uint64_t payload_size = ReadUint64(serialized_response, 20);
+  if (request_id == 0 || !IsValidStatus(status) || !IsValidError(error) ||
+      payload_size > kRemoteGzipperMaxPayloadSize ||
+      payload_size != serialized_response.size() - kResponseHeaderSize ||
+      (status == RemoteGzipperStatus::kSuccess &&
+       error != RemoteGzipperError::kNone) ||
+      (status == RemoteGzipperStatus::kFailure &&
+       error == RemoteGzipperError::kNone)) {
+    return std::nullopt;
+  }
+
+  return RemoteGzipperResponse{
+      request_id, status, error,
+      std::string(serialized_response.substr(kResponseHeaderSize))};
+}
+
+RemoteGzipperError ValidateRemoteGzipperRequest(
+    const RemoteGzipperRequest& request,
+    std::string_view expected_authentication_data) {
+  if (request.authentication_data.empty()) {
+    return RemoteGzipperError::kMissingAuthentication;
+  }
+  if (expected_authentication_data.empty() ||
+      request.authentication_data != expected_authentication_data) {
+    return RemoteGzipperError::kAuthenticationFailed;
+  }
+  if (request.operation_id !=
+      static_cast<uint8_t>(RemoteGzipperOperation::kDeflate)) {
+    return RemoteGzipperError::kUnsupportedOperation;
+  }
+  return RemoteGzipperError::kNone;
+}
+
+RemoteGzipperResponse MakeRemoteGzipperFailureResponse(
+    uint64_t request_id,
+    RemoteGzipperError error) {
+  return RemoteGzipperResponse{request_id, RemoteGzipperStatus::kFailure, error,
+                               std::string()};
+}
+
+bool IsRemoteGzipperResponseForRequest(const RemoteGzipperRequest& request,
+                                       const RemoteGzipperResponse& response) {
+  return response.request_id == request.request_id &&
+         ((response.status == RemoteGzipperStatus::kSuccess &&
+           response.error == RemoteGzipperError::kNone) ||
+          (response.status == RemoteGzipperStatus::kFailure &&
+           response.error != RemoteGzipperError::kNone));
+}
+
+}  // namespace content::distributed
diff --git a/content/distributed/remote_gzipper_protocol.h b/content/distributed/remote_gzipper_protocol.h
new file mode 100644
index 00000000..9c8e7186
--- /dev/null
+++ b/content/distributed/remote_gzipper_protocol.h
@@ -0,0 +1,101 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_DISTRIBUTED_REMOTE_GZIPPER_PROTOCOL_H_
+#define CONTENT_DISTRIBUTED_REMOTE_GZIPPER_PROTOCOL_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace content::distributed {
+
+constexpr uint64_t kRemoteGzipperMaxPayloadSize = 64u * 1024u * 1024u;
+constexpr uint32_t kRemoteGzipperMaxAuthenticationDataSize = 4096;
+constexpr size_t kRemoteGzipperRequestHeaderSize = 28;
+
+// Version 1 supports only data_decoder.mojom.Gzipper::Deflate.
+enum class RemoteGzipperOperation : uint8_t {
+  kDeflate = 1,
+};
+
+enum class RemoteGzipperStatus : uint8_t {
+  kSuccess = 1,
+  kFailure = 2,
+};
+
+enum class RemoteGzipperError : uint32_t {
+  kNone = 0,
+  kMissingAuthentication = 1,
+  kAuthenticationFailed = 2,
+  kUnsupportedOperation = 3,
+  kMalformedFrame = 4,
+  kOversizedPayload = 5,
+  kInternal = 6,
+};
+
+struct RemoteGzipperRequest {
+  uint64_t request_id;
+  uint8_t operation_id;
+  std::string authentication_data;
+  std::string payload;
+};
+
+struct RemoteGzipperResponse {
+  uint64_t request_id;
+  RemoteGzipperStatus status;
+  RemoteGzipperError error;
+  std::string payload;
+};
+
+enum class RemoteGzipperFrameState {
+  kIncomplete,
+  kComplete,
+  kMalformed,
+  kOversized,
+};
+
+// Describes enough of a request frame for a streaming server to know when to
+// continue reading or send an explicit protocol failure. `request_id` is
+// populated whenever a complete fixed header contains a nonzero ID.
+struct RemoteGzipperRequestFrameInfo {
+  RemoteGzipperFrameState state;
+  uint64_t request_id;
+  size_t frame_size;
+};
+
+RemoteGzipperRequestFrameInfo InspectRemoteGzipperRequestFrame(
+    std::string_view serialized_request);
+
+std::optional<std::string> SerializeRemoteGzipperRequest(
+    const RemoteGzipperRequest& request);
+
+std::optional<RemoteGzipperRequest> ParseRemoteGzipperRequest(
+    std::string_view serialized_request);
+
+std::optional<std::string> SerializeRemoteGzipperResponse(
+    const RemoteGzipperResponse& response);
+
+std::optional<RemoteGzipperResponse> ParseRemoteGzipperResponse(
+    std::string_view serialized_response);
+
+// Validates request authentication and returns an explicit worker response
+// error. A worker must return this error in a failure response without logging
+// the supplied authentication data.
+RemoteGzipperError ValidateRemoteGzipperRequest(
+    const RemoteGzipperRequest& request,
+    std::string_view expected_authentication_data);
+
+RemoteGzipperResponse MakeRemoteGzipperFailureResponse(
+    uint64_t request_id,
+    RemoteGzipperError error);
+
+bool IsRemoteGzipperResponseForRequest(const RemoteGzipperRequest& request,
+                                       const RemoteGzipperResponse& response);
+
+}  // namespace content::distributed
+
+#endif  // CONTENT_DISTRIBUTED_REMOTE_GZIPPER_PROTOCOL_H_
diff --git a/content/distributed/remote_gzipper_protocol_unittest.cc b/content/distributed/remote_gzipper_protocol_unittest.cc
new file mode 100644
index 00000000..91530360
--- /dev/null
+++ b/content/distributed/remote_gzipper_protocol_unittest.cc
@@ -0,0 +1,133 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/distributed/remote_gzipper_protocol.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace content::distributed {
+namespace {
+
+RemoteGzipperRequest MakeRequest(uint64_t request_id = 42) {
+  return RemoteGzipperRequest{
+      request_id, static_cast<uint8_t>(RemoteGzipperOperation::kDeflate),
+      "test-token", std::string("binary\0payload", 14)};
+}
+
+TEST(RemoteGzipperProtocolTest, RoundTripsAuthenticatedDeflateRequest) {
+  const auto serialized = SerializeRemoteGzipperRequest(MakeRequest());
+  ASSERT_TRUE(serialized);
+
+  const auto parsed = ParseRemoteGzipperRequest(*serialized);
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(42u, parsed->request_id);
+  EXPECT_EQ(static_cast<uint8_t>(RemoteGzipperOperation::kDeflate),
+            parsed->operation_id);
+  EXPECT_EQ("test-token", parsed->authentication_data);
+  EXPECT_EQ(std::string("binary\0payload", 14), parsed->payload);
+  EXPECT_EQ(RemoteGzipperError::kNone,
+            ValidateRemoteGzipperRequest(*parsed, "test-token"));
+}
+
+TEST(RemoteGzipperProtocolTest, RejectsMalformedRequestFrame) {
+  auto serialized = SerializeRemoteGzipperRequest(MakeRequest());
+  ASSERT_TRUE(serialized);
+  (*serialized)[0] = 'X';
+  EXPECT_FALSE(ParseRemoteGzipperRequest(*serialized));
+}
+
+TEST(RemoteGzipperProtocolTest, ReportsMissingAuthentication) {
+  auto request = MakeRequest();
+  request.authentication_data.clear();
+  EXPECT_FALSE(SerializeRemoteGzipperRequest(request));
+  EXPECT_EQ(RemoteGzipperError::kMissingAuthentication,
+            ValidateRemoteGzipperRequest(request, "test-token"));
+}
+
+TEST(RemoteGzipperProtocolTest, ReportsBadAuthentication) {
+  const auto request = MakeRequest();
+  EXPECT_EQ(RemoteGzipperError::kAuthenticationFailed,
+            ValidateRemoteGzipperRequest(request, "wrong-token"));
+}
+
+TEST(RemoteGzipperProtocolTest, RoundTripsErrorResponse) {
+  const auto response = MakeRemoteGzipperFailureResponse(
+      42, RemoteGzipperError::kUnsupportedOperation);
+  const auto serialized = SerializeRemoteGzipperResponse(response);
+  ASSERT_TRUE(serialized);
+
+  const auto parsed = ParseRemoteGzipperResponse(*serialized);
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(42u, parsed->request_id);
+  EXPECT_EQ(RemoteGzipperStatus::kFailure, parsed->status);
+  EXPECT_EQ(RemoteGzipperError::kUnsupportedOperation, parsed->error);
+  EXPECT_TRUE(parsed->payload.empty());
+}
+
+TEST(RemoteGzipperProtocolTest, RejectsMismatchedResponseRequestId) {
+  const auto request = MakeRequest(42);
+  const RemoteGzipperResponse response{43, RemoteGzipperStatus::kSuccess,
+                                       RemoteGzipperError::kNone, "result"};
+  EXPECT_FALSE(IsRemoteGzipperResponseForRequest(request, response));
+}
+
+TEST(RemoteGzipperProtocolTest, RejectsOversizedPayload) {
+  auto serialized = SerializeRemoteGzipperRequest(MakeRequest());
+  ASSERT_TRUE(serialized);
+  // Request payload length is the 8-byte unsigned integer at byte 20.
+  (*serialized)[20] = static_cast<char>(1);
+  EXPECT_FALSE(ParseRemoteGzipperRequest(*serialized));
+  const auto frame_info = InspectRemoteGzipperRequestFrame(*serialized);
+  EXPECT_EQ(RemoteGzipperFrameState::kOversized, frame_info.state);
+  EXPECT_EQ(42u, frame_info.request_id);
+}
+
+TEST(RemoteGzipperProtocolTest, InspectsFragmentedRequestFrame) {
+  const auto serialized = SerializeRemoteGzipperRequest(MakeRequest());
+  ASSERT_TRUE(serialized);
+
+  auto frame_info = InspectRemoteGzipperRequestFrame(
+      std::string_view(*serialized).substr(0, 12));
+  EXPECT_EQ(RemoteGzipperFrameState::kIncomplete, frame_info.state);
+
+  frame_info = InspectRemoteGzipperRequestFrame(
+      std::string_view(*serialized).substr(0, 28));
+  EXPECT_EQ(RemoteGzipperFrameState::kIncomplete, frame_info.state);
+  EXPECT_EQ(42u, frame_info.request_id);
+  EXPECT_EQ(serialized->size(), frame_info.frame_size);
+
+  frame_info = InspectRemoteGzipperRequestFrame(*serialized);
+  EXPECT_EQ(RemoteGzipperFrameState::kComplete, frame_info.state);
+}
+
+TEST(RemoteGzipperProtocolTest, InspectorReportsTrailingRequestBytes) {
+  auto serialized = SerializeRemoteGzipperRequest(MakeRequest());
+  ASSERT_TRUE(serialized);
+  serialized->push_back('x');
+
+  const auto frame_info = InspectRemoteGzipperRequestFrame(*serialized);
+  EXPECT_EQ(RemoteGzipperFrameState::kMalformed, frame_info.state);
+  EXPECT_EQ(42u, frame_info.request_id);
+}
+
+TEST(RemoteGzipperProtocolTest, RejectsTrailingBytes) {
+  auto serialized = SerializeRemoteGzipperResponse(RemoteGzipperResponse{
+      42, RemoteGzipperStatus::kSuccess, RemoteGzipperError::kNone, "result"});
+  ASSERT_TRUE(serialized);
+  serialized->push_back('x');
+  EXPECT_FALSE(ParseRemoteGzipperResponse(*serialized));
+}
+
+TEST(RemoteGzipperProtocolTest, MakesUnsupportedOperationFailure) {
+  auto request = MakeRequest();
+  request.operation_id = 2;
+  EXPECT_EQ(RemoteGzipperError::kUnsupportedOperation,
+            ValidateRemoteGzipperRequest(request, "test-token"));
+  const auto response = MakeRemoteGzipperFailureResponse(
+      request.request_id, RemoteGzipperError::kUnsupportedOperation);
+  EXPECT_TRUE(IsRemoteGzipperResponseForRequest(request, response));
+}
+
+}  // namespace
+}  // namespace content::distributed
