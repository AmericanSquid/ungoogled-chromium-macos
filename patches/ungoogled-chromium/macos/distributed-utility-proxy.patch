+#include "services/data_decoder/gzipper.h"
+
+namespace content::distributed {
+
+namespace {
+
+constexpr int kListenBacklog = 8;
+constexpr int kReadBufferSize = 16 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kResponseTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("distributed_utility_worker_response",
+                                        R"(
+      semantics {
+        sender: "Distributed Utility Worker"
+        description:
+          "Returns the result of an authenticated Gzipper Deflate request to "
+          "an explicitly configured Chromium client."
+        trigger:
+          "Receipt of an authenticated distributed utility request."
+        data: "Binary Deflate output or a payload-free protocol error."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "The worker is a separately built, manually started experimental "
+          "executable and is disabled unless explicitly configured."
+        policy_exception_justification:
+          "This experimental fork-only feature has no enterprise policy."
+      })");
+
+mojo_base::BigBuffer ToBigBuffer(const std::string& input) {
+  mojo_base::BigBuffer buffer(input.size());
+  if (!input.empty()) {
+    std::memcpy(buffer.data(), input.data(), input.size());
+  }
+  return buffer;
+}
+
+std::string ToString(const mojo_base::BigBuffer& input) {
+  if (input.size() == 0) {
+    return std::string();
+  }
+  return std::string(static_cast<const char*>(input.data()), input.size());
+}
+
+}  // namespace
+
+class RemoteGzipperWorker::Connection {
+ public:
+  Connection(std::unique_ptr<net::StreamSocket> socket,
+             std::string authentication_data,
+             base::OnceClosure completion_callback)
+      : socket_(std::move(socket)),
+        authentication_data_(std::move(authentication_data)),
+        completion_callback_(std::move(completion_callback)) {}
+
+  Connection(const Connection&) = delete;
+  Connection& operator=(const Connection&) = delete;
+  ~Connection() = default;
+
+  void Start() { ReadRequest(); }
+
+ private:
+  void ReadRequest() {
+    read_buffer_ = base::MakeRefCounted<net::IOBufferWithSize>(kReadBufferSize);
+    const int result = socket_->Read(
+        read_buffer_.get(), read_buffer_->size(),
+        base::BindOnce(&Connection::OnRead, weak_factory_.GetWeakPtr()));
+    if (result != net::ERR_IO_PENDING) {
+      OnRead(result);
+    }
+  }
+
+  void OnRead(int result) {
+    if (result <= 0) {
+      Complete();
+      return;
+    }
+    request_bytes_.append(read_buffer_->data(), static_cast<size_t>(result));
+    read_buffer_.reset();
+
+    const auto frame_info = InspectRemoteGzipperRequestFrame(request_bytes_);
+    switch (frame_info.state) {
+      case RemoteGzipperFrameState::kIncomplete:
+        ReadRequest();
+        return;
+      case RemoteGzipperFrameState::kMalformed:
+        SendFailure(frame_info.request_id, RemoteGzipperError::kMalformedFrame);
+        return;
+      case RemoteGzipperFrameState::kOversized:
+        SendFailure(frame_info.request_id,
+                    RemoteGzipperError::kOversizedPayload);
+        return;
+      case RemoteGzipperFrameState::kComplete:
+        break;
+    }
+
+    auto request = ParseRemoteGzipperRequest(request_bytes_);
+    if (!request) {
+      SendFailure(frame_info.request_id, RemoteGzipperError::kMalformedFrame);
+      return;
+    }
+    request_id_ = request->request_id;
+    const RemoteGzipperError error =
+        ValidateRemoteGzipperRequest(*request, authentication_data_);
+    if (error != RemoteGzipperError::kNone) {
+      SendFailure(request_id_, error);
+      return;
+    }
+
+    gzipper_.Deflate(
+        ToBigBuffer(request->payload),
+        base::BindOnce(&Connection::OnDeflated, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnDeflated(std::optional<mojo_base::BigBuffer> output) {
+    if (!output) {
+      SendFailure(request_id_, RemoteGzipperError::kInternal);
+      return;
+    }
+    WriteResponse(
+        RemoteGzipperResponse{request_id_, RemoteGzipperStatus::kSuccess,
+                              RemoteGzipperError::kNone, ToString(*output)});
+  }
+
+  void SendFailure(uint64_t request_id, RemoteGzipperError error) {
+    if (request_id == 0) {
+      Complete();
+      return;
+    }
+    WriteResponse(MakeRemoteGzipperFailureResponse(request_id, error));
+  }
+
+  void WriteResponse(RemoteGzipperResponse response) {
+    auto serialized = SerializeRemoteGzipperResponse(response);
+    if (!serialized) {
+      if (response.error != RemoteGzipperError::kInternal) {
+        SendFailure(response.request_id, RemoteGzipperError::kInternal);
+      } else {
+        Complete();
+      }
+      return;
+    }
+
+    auto source =
+        base::MakeRefCounted<net::StringIOBuffer>(std::move(*serialized));
+    const int response_size = source->size();
+    write_buffer_ = base::MakeRefCounted<net::DrainableIOBuffer>(
+        std::move(source), response_size);
+    WriteMore();
+  }
+
+  void WriteMore() {
+    const int result = socket_->Write(
+        write_buffer_.get(), write_buffer_->BytesRemaining(),
+        base::BindOnce(&Connection::OnWrite, weak_factory_.GetWeakPtr()),
+        kResponseTrafficAnnotation);
+    if (result != net::ERR_IO_PENDING) {
+      OnWrite(result);
+    }
+  }
+
+  void OnWrite(int result) {
+    if (result <= 0) {
+      Complete();
+      return;
+    }
+    write_buffer_->DidConsume(result);
+    if (write_buffer_->BytesRemaining() > 0) {
+      WriteMore();
+      return;
+    }
+    Complete();
+  }
+
+  void Complete() {
+    weak_factory_.InvalidateWeakPtrs();
+    if (socket_) {
+      socket_->Disconnect();
+    }
+    socket_.reset();
+    read_buffer_.reset();
+    write_buffer_.reset();
+    if (completion_callback_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, std::move(completion_callback_));
+    }
+  }
+
+  std::unique_ptr<net::StreamSocket> socket_;
+  const std::string authentication_data_;
+  base::OnceClosure completion_callback_;
+  data_decoder::Gzipper gzipper_;
+  uint64_t request_id_ = 0;
+  std::string request_bytes_;
+  scoped_refptr<net::IOBufferWithSize> read_buffer_;
+  scoped_refptr<net::DrainableIOBuffer> write_buffer_;
+  base::WeakPtrFactory<Connection> weak_factory_{this};
+};
+
+RemoteGzipperWorker::RemoteGzipperWorker(std::string authentication_data)
+    : authentication_data_(std::move(authentication_data)) {}
+
+RemoteGzipperWorker::~RemoteGzipperWorker() {
+  Shutdown();
+}
+
+bool RemoteGzipperWorker::Start(const net::IPEndPoint& listen_endpoint) {
+  if (server_socket_ || authentication_data_.empty()) {
+    return false;
+  }
+
+  auto server =
+      std::make_unique<net::TCPServerSocket>(nullptr, net::NetLogSource());
+  if (server->Listen(listen_endpoint, kListenBacklog, std::nullopt) !=
+      net::OK) {
+    return false;
+  }
+  server_socket_ = std::move(server);
+  AcceptNextConnection();
+  return true;
+}
+
+void RemoteGzipperWorker::Shutdown() {
+  weak_factory_.InvalidateWeakPtrs();
+  connection_.reset();
+  accepted_socket_.reset();
+  server_socket_.reset();
+}
+
+bool RemoteGzipperWorker::GetLocalAddressForTesting(
+    net::IPEndPoint* endpoint) const {
+  return server_socket_ && server_socket_->GetLocalAddress(endpoint) == net::OK;
+}
+
+void RemoteGzipperWorker::AcceptNextConnection() {
+  if (!server_socket_ || connection_) {
+    return;
+  }
+  const int result = server_socket_->Accept(
+      &accepted_socket_, base::BindOnce(&RemoteGzipperWorker::OnAccept,
+                                        weak_factory_.GetWeakPtr()));
+  if (result != net::ERR_IO_PENDING) {
+    OnAccept(result);
+  }
+}
+
+void RemoteGzipperWorker::OnAccept(int result) {
+  if (!server_socket_) {
+    return;
+  }
+  if (result != net::OK) {
+    accepted_socket_.reset();
+    server_socket_.reset();
+    return;
+  }
+
+  connection_ = std::make_unique<Connection>(
+      std::move(accepted_socket_), authentication_data_,
+      base::BindOnce(&RemoteGzipperWorker::OnConnectionComplete,
+                     weak_factory_.GetWeakPtr()));
+  connection_->Start();
+}
+
+void RemoteGzipperWorker::OnConnectionComplete() {
+  connection_.reset();
+  AcceptNextConnection();
+}
+
+}  // namespace content::distributed
