+  kDeflate = 1,
+  kInflate = 2,
+  kCompress = 3,
+  kUncompress = 4,
+};
+
+struct RemoteGzipperFrame {
+  RemoteGzipperMessageType message_type;
+  RemoteGzipperOperation operation;
+  uint64_t request_id;
+  std::string payload;
+};
+
+std::optional<std::string> SerializeRemoteGzipperFrame(
+    const RemoteGzipperFrame& frame);
